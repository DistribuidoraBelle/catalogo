<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<!-- PWA / Agregar a inicio -->
<meta name="theme-color" content="#c4965a">
<link rel="manifest" href="manifest.json">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Belle">
<link rel="apple-touch-icon" href="favicon.svg">
<title>Distribuidora Belle — Perfumes Árabes e Internacionales en Córdoba</title>
<meta name="description" content="Catálogo online de Distribuidora Belle. Perfumes árabes e internacionales 100% originales. Entrega en Córdoba. Precios mayoristas y minoristas.">
<meta property="og:title" content="Distribuidora Belle — Perfumes Árabes e Internacionales">
<meta property="og:description" content="Catálogo de perfumes árabes e internacionales 100% originales. Entrega en Córdoba. Consultá precios mayoristas.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://distribuidorabelle.com/catalogo_index.html">
<meta property="og:site_name" content="Distribuidora Belle">
<meta property="og:image" content="https://distribuidorabelle.com/og-belle.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://distribuidorabelle.com/og-belle.jpg">
<meta name="robots" content="index, follow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{--cream:#faf8f4;--white:#fff;--charcoal:#1a1a1a;--mid:#555;--light:#999;--border:#e8e3db;--accent:#c4965a;--accent-light:#fdf5ea;--bg-body:var(--cream);--bg-header:var(--white);--bg-card:#fff;--bg-input:#fff;--bg-cimg:#f5f2ee;--tx-main:var(--charcoal);--tx-mid:var(--mid);--border-color:var(--border);--card-oferta-bg:#fff5f0;--card-oferta-border:#f0c8b0;}[data-theme="dark"]{--cream:#0f1117;--white:#181c27;--charcoal:#f0ede8;--mid:#a0a8b8;--light:#667;--border:#2a3045;--accent:#e8b86d;--accent-light:rgba(232,184,109,.08);--bg-body:#0f1117;--bg-header:#181c27;--bg-card:#1e2333;--bg-input:#252a3a;--bg-cimg:#252a3a;--tx-main:#f0ede8;--tx-mid:#a0a8b8;--border-color:#2a3045;--card-oferta-bg:rgba(196,90,58,.10);--card-oferta-border:rgba(196,90,58,.35);}
*{box-sizing:border-box;margin:0;padding:0}.card,.drawer,.cimg,.tabs,.filters,header,.sw,.popt,.qb,.abtn,.cart-btn,.tab,.ntext,.toast{transition:background .25s,border-color .25s,color .25s}
html{overflow-x:clip}
body{background:var(--bg-body);font-family:"DM Sans",sans-serif;color:var(--tx-main);min-height:100vh;overflow-x:clip;max-width:100%}
header{background:var(--bg-header);border-bottom:1px solid var(--border-color);padding:0 2rem;position:sticky;top:0;z-index:1000;display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font-family:"Cormorant Garamond",serif;font-size:1.7rem;font-weight:600;letter-spacing:.04em}
.logo span{color:var(--accent)}
.cart-btn{background:var(--tx-main);color:var(--bg-body);border:none;border-radius:8px;padding:.5rem 1.2rem;font-family:"DM Sans",sans-serif;font-size:.85rem;cursor:pointer;display:flex;align-items:center;gap:.5rem;transition:background .2s}
.cart-btn:hover{background:var(--accent)}
.cart-count{background:var(--accent);color:#fff;border-radius:50%;width:20px;height:20px;font-size:.7rem;display:flex;align-items:center;justify-content:center;font-weight:600}
.carousel{position:relative;width:100%;aspect-ratio:20/7;overflow:hidden;background:var(--beige2,#faf8f4)}
.carousel-track{display:flex;height:100%;transition:transform .6s cubic-bezier(.4,0,.2,1);will-change:transform}
.cslide{min-width:100%;width:100%;height:100%;position:relative;flex-shrink:0}
.cslide img{width:100%;height:100%;object-fit:cover;object-position:center;opacity:1}
.cslide-ov{position:absolute;inset:0;background:linear-gradient(to right,rgba(0,0,0,.75) 0%,rgba(0,0,0,.45) 40%,rgba(0,0,0,.1) 65%,transparent 80%);display:flex;align-items:center;padding:0 3rem}
.cslide-txt{color:#fff;max-width:400px}
.cslide-title{font-family:"Cormorant Garamond",serif;font-size:1.9rem;font-weight:600;line-height:1.2;margin-bottom:.4rem;text-shadow:0 2px 8px rgba(0,0,0,.4)}
.cslide-sub{font-size:.85rem;opacity:.88;line-height:1.4}
.cslide-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.5rem;background:linear-gradient(135deg,#1a1a2e,#2d2d44)}
.cslide-ph-num{font-family:"Cormorant Garamond",serif;font-size:3rem;color:var(--accent);opacity:.4}
.car-btn{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.2);backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,.3);color:#fff;width:36px;height:36px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.1rem;transition:background .2s;z-index:10}
.car-btn:hover{background:rgba(255,255,255,.38)}
.car-prev{left:.9rem}.car-next{right:.9rem}
.car-dots{position:absolute;bottom:.8rem;left:50%;transform:translateX(-50%);display:flex;gap:.45rem;z-index:10}
.car-dot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.4);cursor:pointer;transition:all .25s;border:none;padding:0}
.car-dot.act{background:#fff;width:22px;border-radius:4px}
.tabs{display:flex;border-bottom:1px solid var(--border-color);background:var(--bg-header);padding:0 2rem}
.tab{padding:.9rem 1.5rem;cursor:pointer;font-size:.88rem;font-weight:500;color:var(--tx-mid);border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .2s}
.tab.act{color:var(--charcoal);border-bottom-color:var(--accent)}
.tab-camp{margin:0 .15rem;overflow:visible !important;position:relative;padding:.6rem .65rem !important;min-width:75px;display:flex;align-items:center;justify-content:center;background:var(--tab-camp-bg,linear-gradient(135deg,#ff5722,#e64a19));border-radius:6px 6px 0 0;box-shadow:0 2px 8px rgba(255,87,34,.4)}
.tab-camp img{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-height:none}
@keyframes catTabPulseAnim{0%,100%{transform:translate(-50%,-50%) scale(1)}50%{transform:translate(-50%,-50%) scale(1.06)}}
.catTabPulse img{animation:catTabPulseAnim 2.4s ease-in-out infinite}
/* MOBILE: el logo de campaña entra DENTRO de la pestaña (no sobresale) para que el
   scroll horizontal de .tabs no lo recorte y no se cruce con el carrusel ni con el inicio. */
@media(max-width:680px){
  .tab-camp{min-height:50px;padding:.3rem .55rem !important;align-self:center;overflow:visible !important}
  .tab-camp img{height:40px !important;max-width:92px !important;max-height:40px !important}
}
.tabs{overflow:visible !important}
/* ═══════════════════════════════════════════════════════════════ */
/* [Mobile UX] Botón hamburguesa fijo + Drawer lateral de pestañas */
/* En desktop está oculto, en mobile (≤480) se muestra siempre.    */
/* ═══════════════════════════════════════════════════════════════ */
#catTabsHambBtn{display:flex;flex-direction:column;justify-content:center;gap:4px;position:absolute;left:6px;top:50%;transform:translateY(-50%);z-index:1100;background:var(--bg-header);border:1px solid var(--border-color);border-radius:8px;width:40px;height:40px;cursor:pointer;padding:0;align-items:center;box-shadow:0 2px 6px rgba(0,0,0,.08)}
#catTabsHambBtn span{display:block;width:18px;height:2px;background:var(--accent);border-radius:1px;transition:all .2s}
#catTabsHambBtn:hover{border-color:var(--accent)}
#catTabsHambBtn:active{background:var(--accent-light)}
#catTabsHambBtn:active span{background:var(--charcoal)}
@media(max-width:480px){
  #catTabsHambBtn{display:flex !important;flex-direction:column;justify-content:center;gap:4px;position:absolute;left:6px;top:50%;transform:translateY(-50%);z-index:1100;background:var(--bg-header);border:1px solid var(--border-color);border-radius:8px;width:40px;height:40px;cursor:pointer;padding:0;align-items:center;box-shadow:0 2px 6px rgba(0,0,0,.08)}
  #catTabsHambBtn span{display:block;width:18px;height:2px;background:var(--accent);border-radius:1px;transition:all .2s}
  #catTabsHambBtn:active{background:var(--accent-light)}
  #catTabsHambBtn:active span{background:var(--charcoal)}
}
#catTabsDrawerOverlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:9998;backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px)}
#catTabsDrawerOverlay.open{display:block}
#catTabsDrawer{display:none;position:fixed;left:0;top:0;bottom:0;width:280px;max-width:80vw;background:var(--bg-header);z-index:9999;box-shadow:4px 0 24px rgba(0,0,0,.18);transform:translateX(-100%);transition:transform .25s ease;overflow-y:auto}
#catTabsDrawer.open{display:block;transform:translateX(0)}
.catTabsDrawerItem{display:block;width:100%;text-align:left;background:transparent;border:none;padding:.9rem 1.4rem;font-size:.92rem;font-weight:500;color:var(--tx-mid);cursor:pointer;border-left:3px solid transparent;font-family:inherit;line-height:1.3}
.catTabsDrawerItem:active{background:rgba(196,150,90,.1)}
.catTabsDrawerItem.act{background:var(--accent-light);color:var(--accent);font-weight:700;border-left-color:var(--accent)}
.filters{background:var(--bg-header);padding:.75rem 2rem;border-bottom:1px solid var(--border-color);display:flex;gap:.7rem;align-items:center;flex-wrap:wrap}
.sw{position:relative;flex:1 1 340px;min-width:240px;max-width:620px}
.sw input{width:100%;padding:.48rem .8rem .48rem 2rem;border:1px solid var(--border-color);border-radius:6px;font-family:"DM Sans",sans-serif;font-size:.84rem;background:var(--cream);outline:none}
.sw input:focus{border-color:var(--accent)}
.sw-i{position:absolute;left:.6rem;top:50%;transform:translateY(-50%);color:var(--light);font-size:.85rem}
.fsel{padding:.48rem .75rem;border:1px solid var(--border);border-radius:6px;font-family:"DM Sans",sans-serif;font-size:.82rem;background:var(--cream);outline:none;cursor:pointer}
/* FIX 2026-06-26: en desktop, los selects (incluido "Inspirado en") quedan compactos como un filtro mas; el buscador es el largo */
@media(min-width:681px){.fsel{max-width:200px}}
.pills{display:flex;gap:.35rem;flex-wrap:wrap}
.pill{padding:.32rem .75rem;border-radius:20px;border:1px solid var(--border);font-size:.78rem;cursor:pointer;transition:all .15s;background:var(--cream);color:var(--mid)}
.pill.act{background:var(--tx-main);color:var(--bg-body);border-color:var(--tx-main)}.pill-kit.act{background:var(--accent)!important;color:#fff!important;border-color:var(--accent)!important}
.rcount{margin-left:auto;font-size:.78rem;color:var(--light);white-space:nowrap}
.lw{padding:1.2rem 1.5rem 6rem;max-width:1100px;margin:0 auto;overflow-x:hidden}
.list{display:flex;flex-direction:column;gap:.55rem}
.card{background:var(--bg-card);border-radius:10px;border:1px solid var(--border-color);display:flex;align-items:stretch;overflow:hidden;transition:box-shadow .2s,transform .15s}
.card:hover{box-shadow:0 3px 18px rgba(0,0,0,.07);transform:translateY(-1px)}
.card.nostock .popts{opacity:.4}.nostock .add-btn{opacity:.4}.nostock .ci-name{opacity:.6}
.cimg{width:140px;min-width:140px;background:var(--bg-cimg);display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative;flex-shrink:0;border-radius:10px 0 0 10px}.share-btn{position:absolute;bottom:6px;left:6px;top:auto;right:auto;z-index:10;background:rgba(255,255,255,.95);backdrop-filter:blur(6px);border:none;border-radius:50%;width:32px;height:32px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;box-shadow:0 2px 8px rgba(0,0,0,.15);color:#888;transition:transform .2s,box-shadow .2s}
.share-btn:hover{transform:scale(1.1);box-shadow:0 3px 12px rgba(0,0,0,.22);color:#c4965a}
.cimg img{width:100%;height:100%;object-fit:cover;display:none;mix-blend-mode:multiply}[data-theme="dark"] .cimg{background:#fff}[data-theme="dark"] .cimg img{mix-blend-mode:multiply}
.ciph{display:flex;flex-direction:column;align-items:center;gap:.3rem;color:#ccc;font-size:2rem}
.ciph span{font-size:.6rem;color:#bbb}
.ssrib{position:absolute;top:8px;left:-20px;background:#999;color:#fff;font-size:.55rem;font-weight:600;padding:2px 22px;transform:rotate(-45deg);letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}
.avisame-btn{margin-top:.4rem;width:100%;background:linear-gradient(135deg,#c4965a,#a9763f);color:#fff;border:none;border-radius:9px;padding:.55rem .7rem;font-size:.74rem;font-weight:600;font-family:inherit;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:.35rem;box-shadow:0 2px 8px rgba(169,118,63,.25);transition:transform .15s,box-shadow .15s}
.avisame-btn:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(169,118,63,.4)}
.avisame-btn.ok{background:#4caf82;box-shadow:none;cursor:default}
.cinfo{flex:1;padding:.65rem .85rem;display:flex;flex-direction:column;justify-content:flex-start;gap:.2rem;min-width:0;padding-top:.75rem}
.cbrand{font-size:.68rem;color:var(--accent);font-weight:500;text-transform:uppercase;letter-spacing:.07em}
.cname{font-family:"Cormorant Garamond",serif;font-size:1.05rem;font-weight:600;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cgen{font-size:.72rem;color:var(--mid)}
.ntog{font-size:.72rem;color:var(--accent);cursor:pointer;display:inline-block;margin-top:.1rem}
.cpar-tog{font-size:.72rem;color:var(--accent);cursor:pointer;display:inline-block;margin-top:.1rem}
.cpar-wrap{margin-top:.45rem}
.cpar-row{display:flex;gap:.4rem;overflow-x:auto;padding-bottom:.3rem;-webkit-overflow-scrolling:touch}
.cpar-row::-webkit-scrollbar{height:3px}.cpar-row::-webkit-scrollbar-thumb{background:rgba(196,150,90,.3);border-radius:3px}
.cpar-card{flex:0 0 66px;width:66px;cursor:pointer;text-align:center}
.cpar-card:active{transform:scale(.94)}
.cpar-img{width:66px;height:66px;border-radius:9px;background:#fff;border:1px solid rgba(196,150,90,.2);display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:.22rem}
.cpar-img img{width:100%;height:100%;object-fit:contain}
.cpar-nom{font-size:.58rem;color:var(--tx2,#6b5a3e);line-height:1.2;font-weight:600;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.cpar-empty{font-size:.64rem;color:#b0a48e;font-style:italic;padding:.2rem 0}
.ntext{font-size:.71rem;color:var(--tx-mid);line-height:1.6;display:none;margin-top:.3rem;background:var(--bg-cimg);padding:.5rem .65rem;border-radius:5px;border-left:2px solid var(--accent)}
.ntext.open{display:block}
.cright{width:360px;min-width:280px;max-width:360px;padding:.7rem .85rem;border-left:1px solid var(--border);display:flex;flex-direction:column;justify-content:center;gap:.45rem;flex-shrink:1}
/* Top row: 3 prices + decan all inline */
.prices-row{display:flex;gap:.22rem;align-items:stretch;flex-wrap:nowrap}
.popt{flex:1;padding:.35rem .1rem;border:1px solid var(--border-color);border-radius:5px;text-align:center;background:var(--bg-body);transition:all .25s;min-width:0}
.popt.lit{border-color:var(--accent);background:var(--accent-light);box-shadow:0 0 0 2px rgba(196,150,90,.15);transform:translateY(-1px)}
.popt.lit .pov{color:var(--accent)}
.popt.dis{opacity:.3}
.pol{font-size:.5rem;color:var(--light);display:block;margin-bottom:.08rem;text-transform:uppercase;letter-spacing:.02em;white-space:nowrap}
.pov{font-size:.72rem;font-weight:600;color:var(--charcoal);transition:color .2s;white-space:nowrap}
.decan-sep{width:1px;background:var(--border);margin:0 .05rem;flex-shrink:0;align-self:stretch}
/* Decan block: price left, controls right, all in one horizontal row */
.dc-wrap{display:flex;align-items:center;gap:.28rem;flex-shrink:0;background:var(--accent-light);border:1px solid rgba(196,150,90,.35);border-radius:5px;padding:.32rem .38rem}
.dc-price{text-align:center;flex-shrink:0}
.dc-qty{display:flex;align-items:center;gap:.12rem;flex-shrink:0}
.dc-btn{width:14px;height:14px;border:1px solid rgba(196,150,90,.4);border-radius:2px;background:transparent;color:var(--accent);cursor:pointer;font-size:.65rem;display:flex;align-items:center;justify-content:center;font-weight:700;line-height:1;padding:0;flex-shrink:0}
.dc-btn:hover{background:var(--accent);color:#fff}
.dc-num{font-size:.68rem;font-weight:700;color:var(--accent);min-width:12px;text-align:center}
.dc-add{font-size:.52rem;padding:.1rem .25rem;background:var(--accent);color:#fff;border:none;border-radius:3px;cursor:pointer;font-weight:600;flex-shrink:0}
.dc-add:hover{opacity:.85}
.dc-tag{font-size:.55rem;color:var(--accent);white-space:nowrap}
.decan-box{background:var(--accent-light);border:1px solid rgba(196,150,90,.35);border-radius:6px;padding:.38rem .35rem;text-align:center;min-width:62px;max-width:72px;flex-shrink:0;transition:all .2s}
.decan-lbl{font-size:.48rem;color:var(--accent);text-transform:uppercase;letter-spacing:.03em;display:block;margin-bottom:.05rem;font-weight:600;white-space:nowrap}
.decan-val{font-size:.72rem;font-weight:600;color:var(--accent);white-space:nowrap}
/* Decan qty row - compact */
.decan-qty-row{display:flex;align-items:center;gap:.3rem;padding:.28rem .4rem;background:var(--accent-light);border:1px solid rgba(196,150,90,.25);border-radius:5px}
.decan-qty-lbl{font-size:.65rem;color:var(--accent);font-weight:500;white-space:nowrap}
.dq-ctrl{display:flex;align-items:center;border:1px solid rgba(196,150,90,.4);border-radius:4px;overflow:hidden}
.dqb{width:20px;height:20px;border:none;background:transparent;color:var(--accent);cursor:pointer;font-size:.85rem;display:flex;align-items:center;justify-content:center}
.dqb:hover{background:rgba(196,150,90,.15)}
.dqn{width:22px;text-align:center;font-size:.78rem;font-weight:600;color:var(--accent)}
.decan-add-btn{font-size:.68rem;padding:.18rem .45rem;background:var(--accent);color:#fff;border:none;border-radius:4px;cursor:pointer;font-family:"DM Sans",sans-serif;font-weight:500;white-space:nowrap}
.decan-warn{font-size:.6rem;color:rgba(196,150,90,.75);font-style:italic;line-height:1.3}
.qrow{display:flex;align-items:center;gap:.4rem}
.qctrl{display:flex;align-items:center;border:1px solid var(--border);border-radius:5px;overflow:hidden}
.qb{width:26px;height:26px;border:none;background:var(--bg-body);cursor:pointer;font-size:.95rem;display:flex;align-items:center;justify-content:center;transition:background .15s}
.qb:hover{background:var(--accent-light)}
.qn{width:26px;text-align:center;font-size:.85rem;font-weight:500}
.abtn{flex:1;padding:.38rem .35rem;background:var(--tx-main);color:var(--bg-body);border:none;border-radius:5px;cursor:pointer;font-family:"DM Sans",sans-serif;font-size:.75rem;font-weight:500;transition:background .15s;white-space:nowrap}
.abtn:hover{background:var(--accent)}
.abtn:disabled{background:#ccc;cursor:not-allowed}
.icb{font-size:.68rem;color:var(--accent);font-weight:500}
.price-applied{font-size:.67rem;color:var(--accent);font-weight:500;padding:.12rem .35rem;background:var(--accent-light);border-radius:4px;border:1px solid rgba(196,150,90,.25)}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.28);z-index:1150;display:none}
.ov.open{display:block}
.drawer{position:fixed;right:-440px;top:0;bottom:0;width:420px;max-width:100vw;background:var(--bg-header);z-index:1200;transition:right .3s ease;display:flex;flex-direction:column;box-shadow:-4px 0 30px rgba(0,0,0,.1)}
.drawer.open{right:0}
.dh{padding:1.2rem 1.5rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.dt{font-family:"Cormorant Garamond",serif;font-size:1.4rem;font-weight:600}
.xb{background:none;border:none;font-size:1.3rem;cursor:pointer;color:var(--mid)}
.db{flex:1;overflow-y:auto;padding:1rem 1.5rem}
.cemp{text-align:center;color:var(--light);padding:3rem 1rem;font-size:.9rem}
.ci{padding:.75rem 0;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start;gap:.7rem}
.cin{font-size:.84rem;font-weight:500;margin-bottom:.15rem;line-height:1.3}
.cid{font-size:.73rem;color:var(--mid)}
.ciupg{font-size:.71rem;color:#2a7a2a;margin-top:.18rem;font-weight:500}
.cip{font-size:.88rem;font-weight:500;white-space:nowrap}
.crm{background:none;border:none;color:var(--light);cursor:pointer;font-size:.95rem;padding:0 .2rem}
.crm:hover{color:#c33}
.df{padding:1.2rem 1.5rem;border-top:1px solid var(--border)}
.ctot{display:flex;justify-content:space-between;font-size:1rem;font-weight:500;margin-bottom:.8rem}
.ctot span:last-child{font-family:"Cormorant Garamond",serif;font-size:1.2rem}
.warn-decan{background:#fff8ec;border:1px solid #f0c060;border-radius:7px;padding:.6rem .9rem;font-size:.77rem;color:#7a5000;margin-bottom:.7rem}
.upg-banner{background:#f0fff4;border:1px solid #6fcf97;border-radius:7px;padding:.6rem .9rem;font-size:.77rem;color:#1a5c2a;margin-bottom:.7rem}
.wa-btn{width:100%;padding:.82rem;background:#25D366;color:#fff;border:none;border-radius:9px;cursor:pointer;font-family:"DM Sans",sans-serif;font-size:.93rem;font-weight:500;display:flex;align-items:center;justify-content:center;gap:.5rem;transition:background .2s}
.wa-btn:hover{background:#1fc05a}
.wa-btn:disabled{background:#bbb;cursor:not-allowed}
.loading-screen{display:flex;align-items:center;justify-content:center;padding:4rem;flex-direction:column;gap:1rem;color:var(--light)}
.spin{width:28px;height:28px;border:3px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
/* ── Skeletons de carga ── */
.sk-grid{display:flex;flex-direction:column;gap:.55rem}
.sk-card{background:var(--bg-card);border-radius:10px;border:1px solid var(--border-color);display:flex;align-items:stretch;overflow:hidden;min-height:130px}
.sk-card .sk-img{width:130px;min-width:130px;background:#ece7df}
.sk-card .sk-body{flex:1;padding:.85rem 1rem;display:flex;flex-direction:column;gap:.5rem}
.sk-line{height:11px;border-radius:6px;background:#ece7df}
.sk-line.w40{width:40%}.sk-line.w70{width:70%}.sk-line.w55{width:55%}.sk-line.w30{width:30%}
.sk-card .sk-right{width:200px;min-width:200px;padding:.85rem;display:flex;flex-direction:column;gap:.5rem;border-left:1px solid var(--border-color)}
.sk-shimmer{position:relative;overflow:hidden}
.sk-shimmer::after{content:"";position:absolute;inset:0;transform:translateX(-100%);background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);animation:sk-sweep 1.25s infinite}
@keyframes sk-sweep{100%{transform:translateX(100%)}}
@media(max-width:480px){.sk-card{flex-direction:column}.sk-card .sk-img{width:100%;height:150px}.sk-card .sk-right{width:100%;min-width:unset;border-left:none;border-top:1px solid var(--border-color)}}
.wa-float{position:fixed;bottom:1.5rem;right:1.5rem;z-index:150;display:inline-flex;align-items:center;justify-content:center;gap:0;background:#25D366;color:#fff;padding:.85rem;border-radius:50px;box-shadow:0 4px 20px rgba(37,211,102,.4);cursor:pointer;border:none;font-family:"DM Sans",sans-serif;font-size:.82rem;font-weight:600;transition:padding .3s ease,background .25s;text-decoration:none;overflow:hidden;white-space:nowrap;animation:wa-pulse 2.5s infinite}
.wa-float svg{flex-shrink:0}
.wa-float span{max-width:0;opacity:0;overflow:hidden;transition:max-width .35s ease,opacity .25s ease,margin .3s ease}
.toTop-float{position:fixed;bottom:5rem;right:1.3rem;z-index:190;width:42px;height:42px;border-radius:50%;background:var(--accent,#c4965a);color:#fff;border:none;display:none;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.22);opacity:.9;transition:opacity .2s,transform .2s}
.toTop-float:hover{opacity:1;transform:translateY(-2px)}
.toTop-float.show{display:flex}
.toTop-float svg{width:18px;height:18px}
@media(max-width:480px){.toTop-float{width:34px;height:34px;bottom:4.6rem;right:.9rem;opacity:.8}.toTop-float svg{width:15px;height:15px}}
.wa-float:hover{padding:.85rem 1.3rem .85rem 1rem;background:#1fc05a;transform:translateY(-2px)}
.wa-float:hover span{max-width:230px;opacity:1;margin-left:.55rem}
@keyframes wa-pulse{0%,100%{box-shadow:0 4px 20px rgba(37,211,102,.4)}50%{box-shadow:0 4px 28px rgba(37,211,102,.65)}}
@media(max-width:480px){.filters{padding:.6rem 1rem;gap:.45rem}.sw{min-width:100%;max-width:100%;width:100%;flex:0 0 100%}#btnAcordesPanel{flex:1;justify-content:center}.filters>button[onclick*="abrirModalComparador"]{flex:1;justify-content:center}.fsel{flex:1}.pills{width:100%;order:10}}
@media(max-width:480px){.wa-float span{display:none}.wa-float{padding:.7rem;border-radius:50%}}
.toast{position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%) translateY(70px);background:var(--tx-main);color:var(--bg-body);padding:.65rem 1.3rem;border-radius:8px;font-size:.83rem;z-index:400;transition:transform .28s;pointer-events:none}
.toast.show{transform:translateX(-50%) translateY(0)}
@media(max-width:1100px){.cright{width:320px;min-width:320px}}
@media(max-width:900px){.cright{width:290px;min-width:290px}}
@media(max-width:680px){header,.tabs,.filters{padding-left:1rem;padding-right:1rem}.lw{padding:1rem 1rem 5rem}.cright{width:220px;min-width:220px}.cimg{width:110px;min-width:110px}.drawer{width:100vw}.carousel{height:auto;aspect-ratio:20/7}.cslide-title{font-size:1.3rem}.cslide-ov{padding:0 1.2rem}.pov{font-size:.68rem}.decan-box{min-width:52px}.logo{font-size:1.25rem}#catCuentaLabel{display:none}.cuenta-btn{padding:.35rem .55rem}
/* ─── LAYOUT MOBILE FILTROS ─── */
/* La barra .filters pasa a column: buscador arriba (full width), botones en fila abajo */
.filters{flex-direction:column !important;align-items:stretch !important;gap:.5rem !important}
/* Buscador: ancho completo, edge-to-edge */
#catSearchWrap{width:100% !important;flex:1 1 100% !important}
#catSearchWrap input{width:100% !important;box-sizing:border-box}
/* Fila de botones (Filtros + Comparar + Acordes): horizontal, espaciados */
#catBotonesFila{display:flex !important;flex-direction:row !important;gap:.4rem !important;width:100% !important;justify-content:space-between !important;flex-wrap:wrap}
#catBotonesFila > button{flex:1 1 auto;justify-content:center}
/* Botón "Filtros" visible solo en mobile */
#btnFiltrosMobile{display:flex !important;align-items:center;gap:.4rem;background:transparent;border:1.5px solid var(--accent);color:var(--accent);border-radius:20px;padding:.3rem .85rem;font-size:.72rem;cursor:pointer;white-space:nowrap}
/* Filtros colapsables (marcas + género/kit): ocultos por default, se expanden con toggle */
#filtrosColapsables{display:none !important;width:100%;flex-direction:column;gap:.5rem;padding-top:.5rem;border-top:1px solid var(--border-color);margin-top:.2rem}
#filtrosColapsables.expandido{display:flex !important}
#filtrosColapsables.expandido > *{width:100%}
#filtrosColapsables.expandido .pills{flex-wrap:wrap;justify-content:center}
#filtrosColapsables.expandido .fsel{width:100%}
}
/* DESKTOP: misma barra compacta que mobile — buscador + Comparar/Acordes/Filtros en un renglon;
   los selects (marcas, inspirado, ordenar) y las pills quedan colapsados detras del boton "Filtros". */
@media(min-width:681px){
  #catBotonesFila{display:flex !important;flex-direction:row;gap:.5rem;align-items:center}
  #catBotonesFila > button{white-space:nowrap}
  #btnFiltrosMobile{display:flex !important;align-items:center;gap:.4rem;background:transparent;border:1.5px solid var(--accent);color:var(--accent);border-radius:20px;padding:.3rem .85rem;font-size:.72rem;cursor:pointer;white-space:nowrap}
  #filtrosColapsables{display:none !important;width:100%;flex-direction:row;flex-wrap:wrap;gap:.6rem;align-items:center;padding-top:.7rem;margin-top:.5rem;border-top:1px solid var(--border-color)}
  #filtrosColapsables.expandido{display:flex !important}
}
@media(max-width:480px){.card{flex-direction:column}.cimg{width:100%;height:160px;min-width:unset;background:#fff}.cimg img{object-fit:contain;padding:8px;mix-blend-mode:multiply}.fav-heart{top:6px!important;right:6px!important;bottom:auto!important;left:auto!important}.share-btn{top:42px!important;right:6px!important;bottom:auto!important;left:auto!important}
/* ── Mobile: card stacked vertical — cinfo y cright con padding idéntico para alineación prolija ── */
/* Fix del desfase visible donde nombre AFNAN y precios no quedaban alineados verticalmente.   */
/* Forzamos mismo padding lateral y damos fondo/estructura coherente a los dos bloques.        */
.cinfo{padding:.85rem 1rem .65rem !important;gap:.3rem !important}
.cinfo .cname{white-space:normal !important;line-height:1.2;font-size:1rem}
.cright{width:100%;min-width:unset;border-left:none;border-top:1px solid var(--border);padding:.85rem 1rem !important;gap:.55rem !important}
.prices-row{flex-wrap:nowrap}.tabs{overflow-x:auto !important;overflow-y:visible !important;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:0 1rem 0 56px;flex-shrink:0}.tabs::-webkit-scrollbar{display:none}.tab{white-space:nowrap;padding:.9rem 1rem;font-size:.82rem;flex-shrink:0}header{position:sticky;top:0;z-index:1000;-webkit-position:sticky}
.fb-nota-img{width:72px;height:72px;border-radius:8px;}.fb-nota-nombre{font-size:.5rem;max-width:72px;}.fb-notas-fotos{gap:2px;}
footer>div{flex-direction:column;text-align:center;}footer>div>div{text-align:center !important;}
/* ── Decan box en mobile: UN recuadro envolvente, 30% del ancho ── */
/* Visualmente parece un solo box (mismo fondo/borde) pero internamente son 2 columnas */
/* SOLO toca el contenido INTERNO de .dc-wrap, NO toca .prices-row ni nada externo */
.prices-row{flex-wrap:nowrap !important;gap:.25rem !important}
.prices-row>.pov{flex:1 1 0;min-width:0}
.dc-wrap{background:var(--accent-light) !important;border:1px solid rgba(196,150,90,.35) !important;border-radius:5px;padding:.28rem .2rem !important;gap:.15rem;align-items:stretch;flex:0 0 30%;max-width:30%;display:flex;overflow:hidden}
.dc-price{background:transparent;border:none;border-radius:0;padding:0 .15rem 0 0;display:flex;flex-direction:column;justify-content:center;align-items:center;flex:1;min-width:0;border-right:1px solid rgba(196,150,90,.3)}
.dc-qty{background:transparent;border:none;border-radius:0;padding:0 0 0 .1rem;flex:1;min-width:0;display:grid;grid-template-columns:auto auto auto;grid-template-rows:auto auto;gap:.18rem .1rem;justify-content:center;align-items:center;overflow:hidden}
.dc-qty>.dc-btn:first-of-type{grid-column:1;grid-row:1}
.dc-qty>.dc-num{grid-column:2;grid-row:1}
.dc-qty>.dc-btn:nth-of-type(2){grid-column:3;grid-row:1}
.dc-qty>.dc-add{grid-column:1/-1;grid-row:2;width:100%;padding:.22rem .15rem;font-size:.48rem;margin:0;white-space:nowrap;line-height:1.1}
.dc-btn{width:14px;height:14px;font-size:.6rem;padding:0}
.dc-num{font-size:.6rem;min-width:10px}
.decan-lbl{font-size:.42rem;margin-bottom:.08rem;letter-spacing:0;line-height:1.1}
.decan-val{font-size:.62rem;font-weight:700;line-height:1.1}
.dc-tag{display:none}
}

/* ═══════════════════════════════════════════════════════
   MI CUENTA — drawer izquierdo, login/registro/perfil/etc
   ═══════════════════════════════════════════════════════ */
#drawerCuenta{position:fixed;left:-440px;top:0;bottom:0;width:420px;max-width:100vw;background:var(--bg-header);z-index:1100;transition:left .3s ease;display:flex;flex-direction:column;box-shadow:4px 0 30px rgba(0,0,0,.1)}
#drawerCuenta.open{left:0}
#ovCuenta{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.45);z-index:1099;opacity:0;pointer-events:none;transition:opacity .3s}
#ovCuenta.open{opacity:1;pointer-events:auto}
.cuenta-btn{display:flex;align-items:center;gap:.35rem;background:transparent;border:1.5px solid var(--border-color);color:var(--tx-mid);border-radius:20px;padding:.35rem .8rem;font-size:.75rem;cursor:pointer;font-family:'DM Sans',sans-serif;white-space:nowrap}
.cuenta-btn:hover{border-color:var(--accent);color:var(--accent)}
.cuenta-btn.logged{border-color:var(--accent);color:var(--accent)}
.ctab{flex:1;padding:.6rem .4rem;background:transparent;border:none;border-bottom:2px solid transparent;color:var(--mid);font-size:.72rem;font-weight:500;cursor:pointer;transition:all .2s;text-align:center;white-space:nowrap;font-family:inherit}
.ctab.act{color:var(--accent);border-bottom-color:var(--accent)}
.ctab:hover{color:var(--tx-main)}
.cuenta-input{width:100%;padding:.65rem .8rem;border:1px solid var(--border);border-radius:7px;font-size:.84rem;background:var(--bg-card);color:var(--tx-main);font-family:inherit;margin-bottom:.55rem;box-sizing:border-box}
.cuenta-input:focus{outline:none;border-color:var(--accent)}
.cuenta-btn-prim{width:100%;padding:.7rem;background:var(--accent);color:#fff;border:none;border-radius:7px;font-size:.84rem;font-weight:600;cursor:pointer;font-family:inherit;transition:opacity .2s}
.cuenta-btn-prim:hover{opacity:.9}
.cuenta-btn-prim:disabled{opacity:.5;cursor:not-allowed}
.cuenta-link{background:none;border:none;color:var(--accent);font-size:.75rem;cursor:pointer;text-decoration:underline;padding:.3rem;font-family:inherit}
.cuenta-info-box{background:var(--bg-cimg);border:1px solid var(--border);border-radius:8px;padding:.8rem .9rem;margin-bottom:.7rem;font-size:.78rem;line-height:1.4}
.cuenta-row{display:flex;justify-content:space-between;align-items:center;padding:.55rem 0;border-bottom:1px solid var(--border);font-size:.82rem}
.cuenta-row:last-child{border-bottom:none}
.cuenta-row .lbl{color:var(--mid);font-size:.74rem}
.cuenta-row .val{font-weight:500;color:var(--tx-main)}
.fav-heart{position:absolute;top:6px;right:6px;background:rgba(255,255,255,.95);backdrop-filter:blur(6px);border:none;border-radius:50%;width:32px;height:32px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.05rem;box-shadow:0 2px 8px rgba(0,0,0,.15);z-index:10;transition:transform .2s ease,background .2s,box-shadow .2s;padding:0;line-height:1}
.fav-heart:hover{transform:scale(1.1);box-shadow:0 3px 12px rgba(0,0,0,.22)}
.fav-heart.activo{background:rgba(255,242,242,.95);box-shadow:0 2px 10px rgba(230,57,80,.25)}
.fav-heart.activo:hover{box-shadow:0 3px 14px rgba(230,57,80,.4)}
.fav-heart:hover{transform:scale(1.12);background:#fff}
.fav-heart.activo{background:#ffe0e6}
[data-theme="dark"] .fav-heart{background:rgba(40,40,40,.85)}
[data-theme="dark"] .fav-heart.activo{background:rgba(220,38,80,.25)}
.cat-spin{display:inline-block;width:14px;height:14px;border:2px solid rgba(196,150,90,.25);border-top-color:var(--accent);border-radius:50%;animation:cat-spin-anim .7s linear infinite;vertical-align:middle}
@keyframes cat-spin-anim{to{transform:rotate(360deg)}}
.timeline-step{display:flex;gap:.6rem;padding:.55rem 0;font-size:.78rem;border-left:2px solid var(--border);padding-left:.85rem;margin-left:.5rem;position:relative}
.timeline-step::before{content:"";position:absolute;left:-7px;top:.85rem;width:12px;height:12px;border-radius:50%;background:var(--bg-card);border:2px solid var(--border)}
.timeline-step.activo::before{background:var(--accent);border-color:var(--accent)}
.timeline-step .ts-fecha{color:var(--mid);font-size:.7rem}
.timeline-step .ts-estado{font-weight:500;color:var(--tx-main)}
.timeline-step .ts-nota{color:var(--mid);font-size:.74rem;margin-top:.15rem}
@media(max-width:480px){#drawerCuenta{width:100vw;left:-100vw}}

/* Fix: dropdown del autocomplete de Google Maps debe quedar SOBRE el modal de domicilio */
.pac-container{z-index:99999 !important;font-family:'DM Sans',sans-serif !important;border-radius:8px !important;box-shadow:0 4px 16px rgba(0,0,0,.18) !important;border:1px solid #e8d9bf !important;margin-top:2px !important}
.pac-item{padding:.5rem .75rem !important;font-size:.85rem !important;cursor:pointer !important;border-top:1px solid #f5f0e8 !important}
.pac-item:hover{background:#fdf8f0 !important}
.pac-item-query{font-size:.88rem !important;color:#2a1f15 !important}
.pac-matched{font-weight:700 !important;color:#c4965a !important}
.pac-icon{margin-top:5px !important}

.ac-tog{font-size:.72rem;color:var(--accent);cursor:pointer;margin-top:.1rem;display:inline-block}
.ac-wrap{margin-top:.5rem;padding:.65rem .7rem;background:var(--sur2);border-radius:8px;border:1px solid var(--bd)}@media(min-width:481px){.ac-bar-wrap{height:13px}.ac-label{font-size:.51rem;min-width:82px}.ac-pct{font-size:.47rem;min-width:21px}.ac-row{margin-bottom:.21rem}.ac-wrap{padding:.49rem .53rem}}
.ac-row{display:flex;align-items:center;gap:.5rem;margin-bottom:.38rem}
.ac-label{font-size:.68rem;color:var(--tx2);min-width:110px;text-align:right;flex-shrink:0;font-weight:500}
.ac-bar-wrap{flex:1;height:18px;background:rgba(128,128,128,.15);border-radius:20px;overflow:hidden;position:relative}
.ac-bar{height:100%;border-radius:20px;transition:width .7s cubic-bezier(.4,0,.2,1);min-width:6px;width:0%}
.ac-pct{font-size:.63rem;color:var(--tx3);min-width:28px;text-align:right}
[data-theme="dark"] .popt{background:#252a3a;border-color:#333d55}
[data-theme="dark"] .popt.lit{background:rgba(232,184,109,.12);border-color:var(--accent)}
[data-theme="dark"] .pov{color:var(--tx-main)}
[data-theme="dark"] .pol{color:var(--tx-mid)}
[data-theme="dark"] .dc-wrap{background:rgba(232,184,109,.07);border-color:rgba(232,184,109,.25)}
[data-theme="dark"] .dc-btn{background:rgba(232,184,109,.08);border-color:rgba(232,184,109,.2)}
[data-theme="dark"] .decan-box{background:rgba(232,184,109,.07);border-color:rgba(232,184,109,.25)}
[data-theme="dark"] .decan-qty-row{background:rgba(232,184,109,.07);border-color:rgba(232,184,109,.15)}
[data-theme="dark"] .pill{background:#252a3a;border-color:#333d55;color:var(--tx-mid)}
[data-theme="dark"] .pill.act{background:var(--accent);color:#1a1507;border-color:var(--accent)}
[data-theme="dark"] .pill.pill-kit{border-color:rgba(232,184,109,.3);color:var(--accent)}
[data-theme="dark"] .fsel{background:#252a3a;border-color:#333d55;color:var(--tx-main)}
[data-theme="dark"] .sw{background:#252a3a;border-color:#333d55}
[data-theme="dark"] .sw input{color:var(--tx-main)}
[data-theme="dark"] .sw input::placeholder{color:#556}
[data-theme="dark"] .price-applied{background:rgba(232,184,109,.12);border-color:rgba(232,184,109,.25)}
[data-theme="dark"] .qb{background:#252a3a}
[data-theme="dark"] .qb:hover{background:rgba(232,184,109,.12)}
[data-theme="dark"] .qctrl{border-color:#333d55}
[data-theme="dark"] .abtn{background:#333d55;color:var(--tx-main)}
[data-theme="dark"] .abtn:hover{background:var(--accent);color:#1a1507}
[data-theme="dark"] .dh{border-color:#2a3045}
[data-theme="dark"] .ci{border-color:#252a3a}
[data-theme="dark"] .df{border-color:#2a3045}
[data-theme="dark"] .ntext{background:#252a3a;border-left-color:var(--accent)}
[data-theme="dark"] .ssrib{background:#444}
[data-theme="dark"] .ac-wrap{background:#252a3a;border-color:#333d55}
[data-theme="dark"] .ac-bar-wrap{background:rgba(255,255,255,.06)}
[data-theme="dark"] select option{background:#1e2333;color:var(--tx-main)}
[data-theme="dark"] .warn-decan{background:rgba(240,192,96,.07);border-color:rgba(240,192,96,.25);color:#d4aa55}
[data-theme="dark"] .upg-banner{background:rgba(111,207,151,.07);border-color:rgba(111,207,151,.25);color:#5a9}
[data-theme="dark"] .cslide-ov{background:linear-gradient(to top,rgba(15,17,23,.9),transparent)}
[data-theme="dark"] .tab.act{border-bottom-color:var(--accent);color:var(--accent)}
[data-theme="dark"] #themeBtn:hover{border-color:var(--accent);color:var(--accent)}
@media(min-width:480px){.theme-label-txt{display:inline!important}}

#foxChat{position:fixed;bottom:0;right:0;width:100%;max-width:400px;height:520px;max-height:90vh;background:#fff;border-radius:20px 20px 0 0;border:1.5px solid #e8e3db;border-bottom:none;box-shadow:0 -8px 40px rgba(0,0,0,.15);z-index:600;display:flex;flex-direction:column;transform:translateY(100%);transition:transform .35s cubic-bezier(.4,0,.2,1)}
#foxChat.open{transform:translateY(0)}
[data-theme="dark"] #foxChat{background:#181c27;border-color:#2a3045}
#foxChatHead{padding:.9rem 1.1rem;border-bottom:1px solid #f0ede8;display:flex;align-items:center;gap:.6rem;flex-shrink:0}
[data-theme="dark"] #foxChatHead{border-color:#252a3a}
#foxChatHead svg{flex-shrink:0}
.foxChatTitle{font-weight:700;font-size:.88rem;color:#1a1a1a;line-height:1.2}
.foxChatSub{font-size:.67rem;color:#999;margin-top:.05rem}
[data-theme="dark"] .foxChatTitle{color:#f0ede8}
[data-theme="dark"] .foxChatSub{color:#667}
#foxChatClose{margin-left:auto;background:none;border:none;font-size:1.1rem;cursor:pointer;color:#999;padding:.2rem;line-height:1}
#foxMsgs{flex:1;overflow-y:auto;padding:.8rem 1rem;display:flex;flex-direction:column;gap:.6rem;scroll-behavior:smooth}
.fmsg{display:flex;gap:.5rem;align-items:flex-start;animation:msgIn .2s ease}
@keyframes msgIn{from{transform:translateY(6px);opacity:0}to{transform:translateY(0);opacity:1}}
.fmsg.user{flex-direction:row-reverse}
.fmsg-bubble{max-width:82%;padding:.55rem .8rem;border-radius:14px;font-size:.8rem;line-height:1.5}
.fmsg.bot .fmsg-bubble{background:#f5f2ee;color:#1a1a1a;border-radius:4px 14px 14px 14px}
.fmsg.user .fmsg-bubble{background:#c4965a;color:#fff;border-radius:14px 4px 14px 14px}
[data-theme="dark"] .fmsg.bot .fmsg-bubble{background:#252a3a;color:#f0ede8}
.fmsg-av{width:28px;height:28px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1rem;margin-top:.1rem}
.fmsg.bot .fmsg-av{background:#fdf5ea}
.fmsg.user .fmsg-av{background:#c4965a;font-size:.7rem;font-weight:700;color:#fff}
.fprod-card{background:#fff;border:1px solid #e8e3db;border-radius:10px;padding:.6rem .75rem;margin-top:.3rem;cursor:pointer;transition:all .2s}
.fprod-card:hover{border-color:#c4965a;transform:translateY(-1px)}
[data-theme="dark"] .fprod-card{background:#1e2333;border-color:#2a3045}
[data-theme="dark"] .fprod-card:hover{border-color:#e8b86d}
.fprod-name{font-size:.78rem;font-weight:600;color:#1a1a1a;line-height:1.3}
.fprod-detail{font-size:.68rem;color:#888;margin-top:.15rem}
.fprod-price{font-size:.8rem;font-weight:700;color:#c4965a;margin-top:.2rem}
[data-theme="dark"] .fprod-name{color:#f0ede8}
.ftyping{display:flex;gap:4px;align-items:center;padding:.4rem .6rem}
.ftyping span{width:6px;height:6px;background:#c4965a;border-radius:50%;animation:ftyp 1.2s ease infinite}
.ftyping span:nth-child(2){animation-delay:.2s}
.ftyping span:nth-child(3){animation-delay:.4s}
@keyframes ftyp{0%,80%,100%{transform:scale(.6);opacity:.4}40%{transform:scale(1);opacity:1}}
#foxInputWrap{padding:.7rem .9rem;border-top:1px solid #f0ede8;display:flex;gap:.5rem;flex-shrink:0;background:#fff}
[data-theme="dark"] #foxInputWrap{border-color:#252a3a;background:#181c27}
#foxInput{flex:1;border:1.5px solid #e8e3db;border-radius:22px;padding:.5rem 1rem;font-size:.82rem;font-family:"DM Sans",sans-serif;outline:none;background:#fff;color:#1a1a1a;transition:border .2s}
#foxInput:focus{border-color:#c4965a}
[data-theme="dark"] #foxInput{background:#252a3a;border-color:#333d55;color:#f0ede8}
#foxSend{width:36px;height:36px;background:#c4965a;border:none;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .2s}
#foxSend:hover{background:#b8854a}
#foxSend svg{fill:#fff}

.dest-wrap{width:100%;margin:0 0 1.2rem;position:relative;overflow:hidden;aspect-ratio:2400/760;}
.dest-fondo{position:absolute;inset:0;z-index:0;overflow:hidden;}
.dest-fondo img{width:100%;height:100%;object-fit:cover;display:block;}
.dest-fondo-color{position:absolute;inset:0;}
.dest-contenido{position:relative;z-index:1;padding:0;height:100%;display:flex;align-items:center;}
.dest-track{display:flex;gap:.7rem;overflow-x:auto;padding:.6rem 1.5rem .6rem 6rem;-webkit-overflow-scrolling:touch;scrollbar-width:none;-ms-overflow-style:none;align-items:center;width:100%;}
.dest-track::-webkit-scrollbar{display:none;}
.dest-chip{flex:0 0 130px;cursor:pointer;background:#fff;border:none;padding:0;display:flex;flex-direction:column;border-radius:12px;overflow:hidden;box-shadow:0 3px 16px rgba(0,0,0,.13);transition:transform .18s,box-shadow .18s;text-align:left;position:relative;z-index:1;}
.dest-chip:hover{transform:translateY(-4px);box-shadow:0 8px 24px rgba(0,0,0,.18);}
.dest-chip-img{width:100%;height:110px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;}
.dest-chip-img img{width:100%;height:100%;object-fit:contain;padding:8px;mix-blend-mode:multiply;}
.dest-chip-body{padding:.45rem .5rem .55rem;flex:1;display:flex;flex-direction:column;gap:.08rem;}
.dest-chip-brand{font-family:"Cormorant Garamond",Georgia,serif;font-size:.58rem;color:#c4965a;font-weight:600;text-transform:uppercase;letter-spacing:.08em;}
.dest-chip-name{font-family:"Cormorant Garamond",Georgia,serif;font-size:.88rem;font-weight:600;color:#1a1a1a;line-height:1.2;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;margin-bottom:.18rem;}
.dest-chip-tags{display:flex;gap:.18rem;flex-wrap:wrap;margin-bottom:.22rem;}
.dest-chip-tag{font-size:.46rem;font-weight:700;padding:.04rem .25rem;border-radius:3px;}
.dest-chip-tag-tipo{background:rgba(196,150,90,.13);color:#c4965a;border:1px solid rgba(196,150,90,.3);}
.dest-chip-tag-ml{background:#f0f0f0;color:#888;border:1px solid #ddd;}
.dest-chip-prices{display:flex;flex-direction:column;gap:.12rem;}
.dest-chip-price{display:flex;justify-content:space-between;align-items:center;background:rgba(196,150,90,.08);border:1px solid rgba(196,150,90,.22);border-radius:5px;padding:.08rem .32rem;}
.dest-chip-price-lbl{font-size:.46rem;color:#c4965a;font-weight:600;}
.dest-chip-price-val{font-size:.62rem;font-weight:500;color:#333;}
.prod-tag{font-size:.64rem;font-weight:700;padding:.13rem .45rem;border-radius:5px;}
.prod-tag-tipo{background:rgba(196,150,90,.13);color:#c4965a;border:1px solid rgba(196,150,90,.3);}
.prod-tag-ml{background:#f0f0f0;color:#777;border:1px solid #ddd;}
@media(max-width:680px){
  .dest-wrap{aspect-ratio:unset;height:320px;}
  .dest-wrap.dest-only-banner-mobile,
  .dest-wrap:has(.dest-banner-only){aspect-ratio:21/9 !important;height:auto !important;max-height:200px;margin:0 .5rem;border-radius:10px;overflow:hidden;}
  .dest-fondo{display:none;}
  .dest-mobile-scroll{position:absolute;inset:0;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;scrollbar-width:none;background-size:auto 100%;background-repeat:no-repeat;}
  .dest-mobile-scroll.dest-banner-only{background-size:contain !important;background-position:center !important;background-repeat:no-repeat !important;overflow:hidden !important;border-radius:10px;}
  .dest-mobile-scroll::-webkit-scrollbar{display:none;}
  .dest-mobile-cards{display:flex;gap:.7rem;align-items:center;padding:.6rem 1.5rem .6rem 6rem;height:100%;min-width:max-content;}
}

/* === FICHA BELLE MODAL === */
#moFichaBelle{animation:fadeIn .2s ease;}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.fb-header{padding:1.5rem 1.5rem 1rem;background:linear-gradient(135deg,#1a0a2e 0%,#2d1654 100%);position:relative;overflow:hidden;}
.fb-header::before{content:'';position:absolute;top:-40%;right:-5%;width:200px;height:200px;background:radial-gradient(circle,rgba(196,150,90,.2) 0%,transparent 70%);}
.fb-htop{display:flex;gap:1rem;align-items:flex-start;}
.fb-img{width:200px;height:200px;background:rgba(255,255,255,.08);border-radius:16px;overflow:hidden;border:none;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 6px 28px rgba(0,0,0,.35);}
.fb-img img{width:100%;height:100%;object-fit:cover;display:block;}
.fb-info{flex:1;}
.fb-marca{font-size:.65rem;color:rgba(196,150,90,.8);letter-spacing:.1em;text-transform:uppercase;margin-bottom:.25rem;}
.fb-nombre{font-family:'Cormorant Garamond',Georgia,serif;font-size:1.5rem;font-weight:700;color:#fff;line-height:1.15;margin-bottom:.3rem;}
.fb-badges{display:flex;gap:.3rem;flex-wrap:wrap;}
.fb-badge{background:rgba(196,150,90,.2);border:1px solid rgba(196,150,90,.4);color:#e8b86d;padding:.1rem .4rem;border-radius:20px;font-size:.62rem;font-weight:500;}
.fb-familia{margin-top:.7rem;display:flex;gap:.4rem;flex-wrap:wrap;align-items:center;}
.fb-fam-chip{background:rgba(196,150,90,.15);border:1px solid rgba(196,150,90,.3);color:#e8b86d;padding:.15rem .6rem;border-radius:20px;font-size:.68rem;}
.fb-insp{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.6);padding:.15rem .6rem;border-radius:20px;font-size:.62rem;}
.fb-body{padding:1.2rem 1.5rem;}
.fb-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
.fb-section{background:#fff;border-radius:12px;padding:1rem 1.1rem;border:1px solid rgba(196,150,90,.1);}
.fb-section.full{grid-column:1/-1;}
.fb-stitle{font-size:.58rem;text-transform:uppercase;letter-spacing:.12em;color:#9a8060;font-weight:600;margin-bottom:.7rem;display:flex;align-items:center;gap:.35rem;}
.fb-stitle::before{content:'';display:block;width:14px;height:2px;background:#c4965a;border-radius:1px;}
.fb-nota-row{display:flex;align-items:center;gap:.5rem;margin-bottom:.45rem;}
.fb-nota-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.fb-nota-tipo{font-size:.58rem;color:#9a8060;min-width:48px;text-transform:uppercase;letter-spacing:.06em;}
.fb-nota-val{font-size:.72rem;color:#2a1f0f;flex:1;}
.fb-acorde{display:flex;align-items:center;gap:.5rem;margin-bottom:.35rem;}
.fb-acorde-bar{height:26px;border-radius:5px;padding:0 .65rem;font-size:.7rem;font-weight:500;color:#fff;display:flex;align-items:center;min-width:70px;}
.fb-perf-grid{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;}
.fb-perf-item{background:rgba(196,150,90,.04);border:1px solid rgba(196,150,90,.12);border-radius:8px;padding:.6rem;text-align:center;}
.fb-perf-icon{font-size:1.2rem;margin-bottom:.1rem;}
.fb-perf-lbl{font-size:.55rem;color:#9a8060;text-transform:uppercase;letter-spacing:.08em;}
.fb-perf-val{font-size:.78rem;font-weight:600;color:#2a1f0f;}
.fb-proy-dots{display:flex;gap:3px;justify-content:center;margin-top:.3rem;}
.fb-proy-dot{width:9px;height:9px;border-radius:50%;background:#c4965a;}
.fb-proy-dot.off{background:#e8e0d0;}
.fb-estaciones{display:grid;grid-template-columns:1fr 1fr;gap:.35rem;}
.fb-est{border-radius:7px;padding:.4rem .6rem;font-size:.68rem;font-weight:500;display:flex;align-items:center;gap:.3rem;}
.fb-est.off{opacity:.3;filter:grayscale(1);}
.fb-diurno{display:flex;border-radius:7px;overflow:hidden;height:30px;margin-bottom:.5rem;}
.fb-diurno-seg{flex:1;display:flex;align-items:center;justify-content:center;font-size:.67rem;font-weight:500;gap:.2rem;}
.fb-chips{display:flex;gap:.25rem;flex-wrap:wrap;}
.fb-chip{padding:.15rem .45rem;border-radius:20px;font-size:.64rem;font-weight:500;background:#f5f0e8;color:#6b5a3e;border:1px solid rgba(196,150,90,.2);}
.fb-desc{font-size:.78rem;line-height:1.7;color:#6b5a3e;font-style:italic;padding:.4rem 0;}
.fb-desc::before{content:'"';font-family:'Cormorant Garamond',Georgia,serif;font-size:2rem;color:#c4965a;line-height:0;vertical-align:-0.4em;margin-right:.15rem;}
.fb-perfil{background:rgba(196,150,90,.05);border:1px solid rgba(196,150,90,.15);border-radius:10px;padding:.85rem;font-size:.75rem;line-height:1.6;color:#6b5a3e;}
.fb-liquid{display:flex;align-items:center;gap:.5rem;margin-top:.6rem;padding:.5rem .7rem;background:rgba(196,150,90,.04);border-radius:7px;border:1px solid rgba(196,150,90,.12);}
.fb-liq-dot{width:18px;height:18px;border-radius:50%;border:2px solid rgba(0,0,0,.1);flex-shrink:0;}
.fb-footer{background:#1a1209;padding:.85rem 1.5rem;display:flex;align-items:center;justify-content:space-between;}
.fb-nota-tier{margin-bottom:1.2rem;}
.fb-nota-tier-header{display:flex;align-items:center;gap:.4rem;margin-bottom:.6rem;}
.fb-notas-fotos{display:flex;flex-wrap:wrap;gap:2px;padding:.3rem 0;justify-content:center;}
.fb-nota-foto-item{display:flex;flex-direction:column;align-items:center;gap:.35rem;cursor:pointer;flex-shrink:0;}
.fb-nota-img{width:110px;height:110px;object-fit:cover;border-radius:10px;border:2px solid rgba(196,150,90,.15);box-shadow:0 2px 8px rgba(0,0,0,.08);display:block;transition:transform .15s;}
.fb-nota-foto-item:hover .fb-nota-img{transform:scale(1.04);}
.fb-nota-nombre{font-size:.6rem;text-align:center;color:#6b5a3e;line-height:1.2;font-weight:500;max-width:110px;padding:0 2px;}
.fb-acorde-row{display:flex;align-items:center;gap:.5rem;margin-bottom:.35rem;}
.fb-acorde-label{font-size:.68rem;color:#6b5a3e;min-width:90px;font-weight:500;}
.fb-acorde-bar-wrap{flex:1;background:#f0ece4;border-radius:4px;height:22px;overflow:hidden;}
.fb-acorde-bar-fill{height:100%;border-radius:4px;transition:width .3s ease;display:flex;align-items:center;padding-left:.4rem;font-size:.6rem;font-weight:600;}
.fb-acorde-pct{font-size:.62rem;color:#9a8060;min-width:28px;text-align:right;}
.fb-footer-logo{font-family:'Cormorant Garamond',Georgia,serif;color:#c4965a;font-size:1.15rem;font-weight:700;letter-spacing:.02em;}
.fb-footer-url{font-size:.82rem;color:#c4965a;font-weight:600;letter-spacing:.03em;}
.fb-share-btns{display:flex;gap:.4rem;}
.fb-share-btn{background:transparent;border:1px solid rgba(196,150,90,.3);color:#e8b86d;padding:.2rem .6rem;border-radius:20px;cursor:pointer;font-size:.65rem;font-family:inherit;}
.fb-share-btn:hover{background:#c4965a;color:#1a1209;}
@media(max-width:580px){
  .fb-grid{grid-template-columns:1fr;}
  .fb-section.full{grid-column:auto;}
  .fb-nombre{font-size:1.2rem;}
  .fb-htop{flex-direction:column;}
  .fb-img{width:80px;height:80px;}
  .fb-body{padding:.9rem 1rem;}
}

/* BARRA DE ANUNCIOS */
#annBar{overflow:hidden;height:36px;display:flex;align-items:center;position:relative;border-bottom:1px solid rgba(196,150,90,.3);background:linear-gradient(90deg,#1a0a2e 0%,#2d1654 50%,#1a0a2e 100%)}
#annBar::before,#annBar::after{content:'';position:absolute;top:0;bottom:0;width:60px;z-index:2;pointer-events:none}
#annBar::before{left:0;background:linear-gradient(to right,var(--ann-fade,#1a0a2e),transparent)}
#annBar::after{right:0;background:linear-gradient(to left,var(--ann-fade,#1a0a2e),transparent)}
.ann-track{display:flex;align-items:center;white-space:nowrap;animation:annScroll 35s linear infinite;will-change:transform}
.ann-track:hover{animation-play-state:paused}
@keyframes annScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.ann-sep{margin:0 2rem;opacity:.8;font-size:.85rem;color:var(--ann-sep,#c4965a)}
.ann-msg{font-size:.74rem;letter-spacing:.05em;font-family:"DM Sans",sans-serif;color:var(--ann-txt,#fff)}
.ann-msg strong{font-weight:700;color:var(--ann-strong,#e8b86d)}
/* Temas */
#annBar.ann-violeta{background:linear-gradient(90deg,#1a0a2e 0%,#2d1654 50%,#1a0a2e 100%);--ann-fade:#1a0a2e;--ann-txt:#fff;--ann-strong:#e8b86d;--ann-sep:#c4965a;border-bottom-color:rgba(196,150,90,.3)}
#annBar.ann-dorado{background:linear-gradient(90deg,#7a4a00 0%,#c4965a 30%,#e8b86d 50%,#c4965a 70%,#7a4a00 100%);--ann-fade:#7a4a00;--ann-txt:#1a0a00;--ann-strong:#1a0a00;--ann-sep:rgba(26,10,0,.5);border-bottom-color:rgba(120,70,0,.4)}
#annBar.ann-negro{background:#111;--ann-fade:#111;--ann-txt:#fff;--ann-strong:#c4965a;--ann-sep:#c4965a;border-bottom-color:rgba(196,150,90,.2)}
#annBar.ann-blanco{background:#fff;--ann-fade:#fff;--ann-txt:#1a1a1a;--ann-strong:#8b5e1a;--ann-sep:#c4965a;border-bottom-color:#e8e3db}
#annBar.ann-rosa{background:linear-gradient(90deg,#f5e6d8 0%,#faf0e8 50%,#f5e6d8 100%);--ann-fade:#f5e6d8;--ann-txt:#5a3a1a;--ann-strong:#8b4513;--ann-sep:#c4965a;border-bottom-color:#e8c8a8}
#annBar.ann-verde{background:linear-gradient(90deg,#0d2818 0%,#1a4a2e 50%,#0d2818 100%);--ann-fade:#0d2818;--ann-txt:#fff;--ann-strong:#c4965a;--ann-sep:#c4965a;border-bottom-color:rgba(196,150,90,.3)}
/* Hamburguesa también en PC: dejar lugar a la izquierda de las pestañas (≥481px) */
@media(min-width:481px){.tabs{padding-left:56px}}
</style>
