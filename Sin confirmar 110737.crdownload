<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300..600&display=swap" rel="stylesheet">
<style id="tema-pestanas-elegante">
/* ── Pestañas y buscador: tipografía elegante (Jost) ── */
.tab,.catTabsDrawerItem,.sw input,.fsel{font-family:'Jost',sans-serif!important}
/* ── Pestañas: cada una un color elegante distinto ── */
/* Título con un toque de su color; hover ilumina suave; activa = color pleno */
.tabs .tab:not(.tab-camp){border-bottom:2.5px solid transparent!important;transition:background .2s,color .2s,border-color .2s;color:var(--tcmut,#666)!important}
.tabs .tab:not(.tab-camp):hover{background:var(--tcsoft,rgba(196,150,90,.19))!important;color:var(--tc,#c4965a)!important}
.tabs .tab:not(.tab-camp).act{color:var(--tc,#c4965a)!important;border-bottom-color:var(--tc,#c4965a)!important;font-weight:600}
.catTabsDrawerItem:not(.tab-camp){color:var(--tcmut,#666)!important;transition:background .2s,color .2s}
.catTabsDrawerItem:not(.tab-camp):hover{background:var(--tcsoft,rgba(196,150,90,.19))!important;color:var(--tc)!important}
.catTabsDrawerItem:not(.tab-camp).act{color:var(--tc)!important;border-left-color:var(--tc)!important;background:var(--tcsoft)!important}
</style>
<style id="svEstilos">
#serviciosOverlay{position:fixed;inset:0;z-index:100000;overflow-y:auto;-webkit-overflow-scrolling:touch;background:#f7f1e6;display:none;font-family:'Jost',system-ui,sans-serif;color:#2e2820}
#serviciosOverlay.sv-open{display:block}
.sv-back{position:fixed;top:16px;left:16px;z-index:100010;display:inline-flex;align-items:center;gap:7px;background:rgba(20,14,8,.55);color:#fff;border:1px solid rgba(255,255,255,.25);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);font-family:'Jost',sans-serif;font-size:13.5px;font-weight:500;padding:9px 16px 9px 12px;border-radius:30px;cursor:pointer;transition:all .25s}
.sv-back:hover{background:rgba(20,14,8,.8)}
.sv-back svg{width:17px;height:17px}
.sv-wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.sv-hero{position:relative;min-height:90vh;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;color:#fff}
.sv-hero-bg{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?w=1400&q=80') center/cover;transform:scale(1.08);animation:svken 18s ease-out infinite alternate}
@keyframes svken{to{transform:scale(1.18) translateY(-14px)}}
.sv-hero-ov{position:absolute;inset:0;background:linear-gradient(180deg,rgba(16,12,8,.6),rgba(16,12,8,.78) 55%,rgba(16,12,8,.95))}
.sv-hero-glow{position:absolute;top:34%;left:50%;width:620px;height:620px;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(201,162,75,.28),transparent 62%);filter:blur(20px);animation:svbreathe 6s ease-in-out infinite}
@keyframes svbreathe{0%,100%{opacity:.55;transform:translate(-50%,-50%) scale(1)}50%{opacity:1;transform:translate(-50%,-50%) scale(1.12)}}
.sv-hero-inner{position:relative;z-index:2;padding:0 22px;max-width:760px}
.sv-kicker{font-size:12px;letter-spacing:.42em;text-transform:uppercase;color:#e6c878;font-weight:500;margin-bottom:22px;opacity:0;animation:svup .9s .2s forwards}
.sv-hero h1{font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(44px,9vw,84px);line-height:1.02;margin-bottom:20px}
.sv-hero h1 .l{display:inline-block;opacity:0;transform:translateY(30px);animation:svup 1s forwards}
.sv-hero h1 .l:nth-child(1){animation-delay:.35s}
.sv-hero h1 .l:nth-child(2){animation-delay:.5s;color:#e6c878;font-style:italic}
.sv-hero p{font-size:clamp(15px,2.4vw,19px);color:#e8ddca;line-height:1.6;max-width:500px;margin:0 auto 34px;font-weight:300;opacity:0;animation:svup 1s .75s forwards}
.sv-cta{display:inline-flex;align-items:center;gap:10px;background:linear-gradient(135deg,#e6c878,#9a7a34);color:#231c10;font-weight:600;font-size:15px;padding:15px 34px;border-radius:40px;text-decoration:none;box-shadow:0 12px 34px -8px rgba(201,162,75,.6);opacity:0;animation:svup 1s .95s forwards;transition:transform .3s,box-shadow .3s;cursor:pointer;border:none;font-family:'Jost',sans-serif}
.sv-cta:hover{transform:translateY(-3px);box-shadow:0 18px 44px -8px rgba(201,162,75,.8)}
.sv-cta svg{width:16px;height:16px}
.sv-scroll{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);z-index:2;width:26px;height:42px;border:2px solid rgba(255,255,255,.4);border-radius:16px;opacity:0;animation:svup 1s 1.3s forwards}
.sv-scroll::after{content:'';position:absolute;top:8px;left:50%;transform:translateX(-50%);width:4px;height:8px;background:#e6c878;border-radius:3px;animation:svdot 1.6s ease-in-out infinite}
@keyframes svdot{0%{opacity:0;top:8px}40%{opacity:1}80%{opacity:0;top:22px}100%{opacity:0}}
@keyframes svup{to{opacity:1;transform:translateY(0)}}
.sv-stats{background:#1a1712;color:#fff;padding:44px 0}
.sv-stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center}
.sv-stat{position:relative}
.sv-stat .num{font-family:'Cormorant Garamond',serif;font-size:clamp(32px,6vw,50px);font-weight:600;color:#e6c878;line-height:1}
.sv-stat .lbl{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#b8ad97;margin-top:8px}
.sv-stat:not(:last-child)::after{content:'';position:absolute;right:-10px;top:14%;height:72%;width:1px;background:rgba(201,162,75,.22)}
.sv-sec{padding:70px 0 30px}
.sv-head{text-align:center;max-width:560px;margin:0 auto 44px}
.sv-head .eb{font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#9a7a34;font-weight:600;margin-bottom:14px}
.sv-head h2{font-family:'Cormorant Garamond',serif;font-size:clamp(30px,5vw,44px);font-weight:600;color:#1a1712;line-height:1.08;margin-bottom:14px}
.sv-head p{font-size:15px;color:#6b5f4e;line-height:1.6}
.sv-bento{display:grid;grid-template-columns:repeat(6,1fr);gap:16px;grid-auto-rows:minmax(150px,auto)}
.sv-card{position:relative;border-radius:20px;overflow:hidden;background:#fffdf8;border:1px solid #e6d8bd;padding:24px;display:flex;flex-direction:column;justify-content:flex-end;min-height:200px;opacity:0;transform:translateY(36px);transition:transform .7s cubic-bezier(.2,.7,.2,1),opacity .7s,box-shadow .4s,border-color .4s}
.sv-card.sv-in{opacity:1;transform:translateY(0)}
.sv-card:hover{box-shadow:0 26px 60px -22px rgba(80,58,20,.45);border-color:#c9a24b;transform:translateY(-6px)}
.sv-card .ic{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:auto;position:relative;z-index:2;transition:transform .4s}
.sv-card:hover .ic{transform:scale(1.08) rotate(-4deg)}
.sv-card .ic svg{width:26px;height:26px}
.sv-card h3{font-family:'Cormorant Garamond',serif;font-size:25px;font-weight:600;margin:16px 0 7px;position:relative;z-index:2;line-height:1.1}
.sv-card p{font-size:13.5px;line-height:1.55;color:#6b5f4e;position:relative;z-index:2}
.sv-card.img{color:#fff;border:none}
.sv-card.img .cbg{position:absolute;inset:0;background-size:cover;background-position:center;transition:transform .8s}
.sv-card.img:hover .cbg{transform:scale(1.09)}
.sv-card.img .cov{position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,14,8,.15),rgba(20,14,8,.86))}
.sv-card.img h3{color:#fff}
.sv-card.img p{color:#e8ddca}
.sv-c-tall{grid-column:span 2;grid-row:span 2}
.sv-c-mid{grid-column:span 3}
.sv-c-sm{grid-column:span 2}
.sv-gen{background:linear-gradient(160deg,#1a1712,#241c12);color:#fff;border-radius:26px;overflow:hidden;margin:20px 0 10px}
.sv-gen-inner{display:grid;grid-template-columns:1fr 340px}
.sv-gen-txt{padding:44px 40px}
.sv-gen-txt .eb{font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#e6c878;font-weight:600;margin-bottom:16px}
.sv-gen-txt h2{font-family:'Cormorant Garamond',serif;font-size:38px;font-weight:600;line-height:1.06;margin-bottom:14px}
.sv-gen-txt>p{font-size:15px;color:#d8cdb8;line-height:1.6;margin-bottom:26px;max-width:420px}
.sv-glabel{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#a89d86;margin-bottom:9px;font-weight:500}
.sv-seg{display:inline-flex;background:rgba(255,255,255,.07);border:1px solid rgba(201,162,75,.24);border-radius:30px;padding:4px;gap:2px;margin-bottom:18px}
.sv-seg button{background:transparent;border:none;color:#c9bfa8;font-family:'Jost',sans-serif;font-size:13px;font-weight:500;padding:8px 18px;border-radius:30px;cursor:pointer;transition:all .3s}
.sv-seg button.on{background:linear-gradient(135deg,#e6c878,#9a7a34);color:#231c10;font-weight:600}
.sv-gen-prev{background:radial-gradient(80% 70% at 50% 30%,rgba(201,162,75,.14),transparent 70%);display:flex;align-items:center;justify-content:center;padding:34px 26px}
.sv-mini{width:230px;border-radius:16px;overflow:hidden;transition:all .5s cubic-bezier(.2,.7,.2,1);box-shadow:0 24px 50px -18px rgba(0,0,0,.6)}
.sv-mini .mimg{height:132px;display:flex;align-items:center;justify-content:center}
.sv-mini .mbody{padding:15px 16px}
.sv-mini .mbrand{font-size:9px;letter-spacing:.14em;text-transform:uppercase;font-weight:600}
.sv-mini .mname{font-size:17px;font-weight:700;margin:2px 0 9px}
.sv-mini .macc{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:11px}
.sv-mini .macc span{font-size:9.5px;font-weight:600;padding:3px 9px;border-radius:16px}
.sv-mini .mfoot{display:flex;justify-content:space-between;align-items:center}
.sv-mini .mprice{font-size:19px;font-weight:800}
.sv-mini .mtag{font-size:9px;text-align:right;line-height:1.35}
.sv-mini.f-min{background:#fff;font-family:'Jost',sans-serif}
.sv-mini.f-min .mimg{background:#f5f4f1;color:#cbc5bb}
.sv-mini.f-min .mbrand{color:#b0a68f}.sv-mini.f-min .mname{color:#232323}
.sv-mini.f-min .macc span{background:#f0eee9;color:#7a7365}
.sv-mini.f-min .mprice{color:#232323}.sv-mini.f-min .mtag{color:#999}
.sv-mini.f-lux{background:#14110d;font-family:'Cormorant Garamond',serif;text-align:center}
.sv-mini.f-lux .mimg{background:radial-gradient(60% 55% at 50% 42%,#2a2318,#14110d);color:#8a7440}
.sv-mini.f-lux .mbrand{color:#c9a24b;letter-spacing:.28em}
.sv-mini.f-lux .mname{color:#f2e9d6;font-weight:500;font-size:20px}
.sv-mini.f-lux .macc{justify-content:center}
.sv-mini.f-lux .macc span{background:transparent;border:1px solid rgba(201,162,75,.4);color:#c9b98a;font-family:'Jost',sans-serif}
.sv-mini.f-lux .mfoot{flex-direction:column;gap:3px}
.sv-mini.f-lux .mprice{color:#c9a24b;font-weight:500;font-family:'Jost',sans-serif}
.sv-mini.f-lux .mtag{color:#7a6f58;text-align:center;font-family:'Jost',sans-serif}
.sv-mini.f-mod{background:#fff;font-family:'Jost',sans-serif}
.sv-mini.f-mod .mimg{background:linear-gradient(135deg,#efe4fb,#fce4f0);color:#a06fc4}
.sv-mini.f-mod .mbrand{color:#a89ab5}.sv-mini.f-mod .mname{color:#2a2233}
.sv-mini.f-mod .macc span{color:#fff}
.sv-mini.f-mod .macc span:nth-child(1){background:#a06fc4}
.sv-mini.f-mod .macc span:nth-child(2){background:#d4589a}
.sv-mini.f-mod .macc span:nth-child(3){background:#e0913f}
.sv-mini.f-mod .mprice{color:#a06fc4}.sv-mini.f-mod .mtag{color:#a89ab5}
.sv-mini.story{width:190px}.sv-mini.story .mimg{height:220px}
.sv-final{text-align:center;padding:64px 20px 84px}
.sv-final h2{font-family:'Cormorant Garamond',serif;font-size:clamp(30px,5vw,42px);font-weight:600;color:#1a1712;margin-bottom:14px;line-height:1.1}
.sv-final p{font-size:15px;color:#6b5f4e;margin-bottom:28px}
.sv-final .wa{display:inline-flex;align-items:center;gap:9px;background:#25a35a;color:#fff;font-weight:600;font-size:15px;padding:15px 34px;border-radius:40px;text-decoration:none;cursor:pointer;border:none;font-family:'Jost',sans-serif;transition:all .3s;box-shadow:0 12px 30px -10px rgba(37,163,90,.6)}
.sv-final .wa:hover{background:#1e8a4c;transform:translateY(-2px)}
.sv-final .wa svg{width:19px;height:19px}
@media(max-width:820px){
  .sv-stats-grid{grid-template-columns:repeat(2,1fr);gap:28px 16px}
  .sv-stat:not(:last-child)::after{display:none}
  .sv-bento{grid-template-columns:repeat(2,1fr)}
  .sv-c-tall,.sv-c-mid,.sv-c-sm{grid-column:span 2;grid-row:auto}
  .sv-gen-inner{grid-template-columns:1fr}
  .sv-gen-txt{padding:34px 26px}
}
</style>
<style id="gtEstilos">
#genTarjetaOverlay{position:fixed;inset:0;z-index:100000;overflow-y:auto;background:#f4efe6;display:none;font-family:'Jost',system-ui,sans-serif;color:#2e2820}
#genTarjetaOverlay.gt-open{display:block}
.gt-back{position:fixed;top:14px;left:14px;z-index:100010;display:inline-flex;align-items:center;gap:6px;background:#2e2820;color:#fff;border:none;font-family:'Jost',sans-serif;font-size:13.5px;font-weight:500;padding:9px 15px 9px 11px;border-radius:30px;cursor:pointer;box-shadow:0 6px 18px -6px rgba(0,0,0,.4)}
.gt-back svg{width:16px;height:16px}
.gt-wrap{max-width:1000px;margin:0 auto;padding:60px 18px 40px}
.gt-head{text-align:center;margin-bottom:24px}
.gt-head h2{font-family:'Cormorant Garamond',serif;font-size:34px;font-weight:600;color:#1a1712;line-height:1.1;margin:0 0 8px}
.gt-head p{font-size:14px;color:#6b5f4e;line-height:1.55;max-width:460px;margin:0 auto}
.gt-grid{display:grid;grid-template-columns:360px 1fr;gap:26px;align-items:start}
.gt-controls{background:#fffdf8;border:1px solid #e6d8bd;border-radius:18px;padding:20px}
.gt-lbl{display:block;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#9a8a6a;font-weight:600;margin:16px 0 6px}
.gt-lbl:first-child{margin-top:0}
.gt-input{width:100%;border:1px solid #e0d3b8;border-radius:10px;padding:11px 13px;font-family:'Jost',sans-serif;font-size:14px;color:#2e2820;background:#fff;outline:none;transition:border-color .2s}
.gt-input:focus{border-color:#c4965a}
.gt-results{display:none;border:1px solid #e6d8bd;border-radius:10px;margin-top:5px;overflow:hidden;background:#fff}
.gt-res{padding:10px 13px;font-size:13px;cursor:pointer;border-bottom:1px solid #f0e8d8;transition:background .15s}
.gt-res:last-child{border-bottom:none}
.gt-res:hover{background:#faf3e4}
.gt-nores{padding:10px 13px;font-size:13px;color:#9a8a6a}
.gt-selname{font-size:13px;color:#5a8a4a;font-weight:600;margin-top:7px;min-height:0}
.gt-seg{display:flex;background:#f3ebd8;border-radius:12px;padding:4px;gap:3px}
.gt-seg button{flex:1;background:transparent;border:none;color:#8a7c60;font-family:'Jost',sans-serif;font-size:12.5px;font-weight:500;padding:9px 4px;border-radius:9px;cursor:pointer;transition:all .25s}
.gt-seg button.on{background:#fff;color:#a06a2a;font-weight:600;box-shadow:0 2px 6px rgba(0,0,0,.08)}
.gt-toggles{display:flex;flex-direction:column;gap:9px}
.gt-tog{display:flex;align-items:center;gap:9px;font-size:13.5px;color:#4a4136;cursor:pointer}
.gt-tog input{width:17px;height:17px;accent-color:#c4965a;cursor:pointer}
.gt-actions{display:flex;flex-direction:column;gap:9px;margin-top:20px}
.gt-btn{border:none;border-radius:11px;padding:13px;font-family:'Jost',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:all .25s}
.gt-btn-main{background:linear-gradient(135deg,#d4a830,#a06a2a);color:#fff;box-shadow:0 8px 20px -8px rgba(196,150,90,.7)}
.gt-btn-main:hover{transform:translateY(-2px)}
.gt-btn-alt{background:#fff;border:1px solid #e0d3b8;color:#6b5f4e}
.gt-btn-alt:hover{border-color:#c4965a;color:#a06a2a}
.gt-msg{font-size:12.5px;color:#5a8a4a;text-align:center;min-height:18px;margin-top:10px}
.gt-preview{position:sticky;top:16px;display:flex;align-items:flex-start;justify-content:center;padding:10px}

/* ══ TARJETA ══ */
.gt-empty{color:#a3906f;font-size:14px;font-style:italic;padding:80px 20px;text-align:center}
.gt-card{width:360px;border-radius:18px;overflow:hidden;box-shadow:0 22px 55px -20px rgba(80,60,20,.4);text-align:center}
.gt-card.story{width:300px}
.gt-photo{position:relative;display:flex;align-items:center;justify-content:center;height:190px;overflow:hidden;isolation:isolate}
.gt-card.story .gt-photo{height:300px}
.gt-photo img{max-height:88%;max-width:82%;object-fit:contain;mix-blend-mode:multiply}
.gt-noimg{opacity:.4}
.gt-body{padding:16px 18px 18px}
.gt-brand{font-size:10px;font-weight:600;margin-bottom:3px}
.gt-name{font-weight:700;line-height:1.1;margin-bottom:4px}
.gt-sub{font-size:11px;margin-bottom:11px;opacity:.8;letter-spacing:.02em}
.gt-acc{margin-bottom:12px}
.gt-acc-bars .gt-bar{display:flex;align-items:center;gap:8px;margin-bottom:5px}
.gt-acc-bars .gt-bname{font-size:10px;width:60px;flex-shrink:0}
.gt-acc-bars .gt-bpct{font-size:9px;width:26px;flex-shrink:0;text-align:right;color:#a99;opacity:.85}
.gt-acc-bars .gt-btrack{flex:1;height:5px;border-radius:3px;overflow:hidden}
.gt-acc-bars .gt-bfill{height:100%;border-radius:3px}
.gt-acc-dots{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
.gt-acc-dots .gt-dot{text-align:center}
.gt-acc-dots .gt-dring{width:40px;height:40px;border-radius:50%;border:2px solid;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;margin:0 auto 4px}
.gt-acc-dots .gt-dsvg{width:46px;height:46px;display:block;margin:0 auto 4px}
.gt-acc-dots .gt-dot span{font-size:9px;display:block}
.gt-acc-pills{display:flex;flex-wrap:wrap;gap:6px}
.gt-acc-pills .gt-pill{font-size:10px;font-weight:600;color:#fff;padding:4px 11px;border-radius:20px}
.gt-acc-pills .gt-pill b{font-weight:700;opacity:.85}
.gt-notas{margin-bottom:13px}
.gt-notas-foto{display:flex;flex-wrap:wrap;gap:9px}
.gt-notas-foto .gt-nota{text-align:center;width:46px;flex-shrink:0}
.gt-notas-foto .gt-nimg{width:42px;height:42px;border-radius:50%;display:block;margin:0 auto 3px;border:1px solid rgba(0,0,0,.06)}
.gt-notas-foto .gt-nota span{font-size:8px;line-height:1.1;display:block}
.gt-notas-txt{display:flex;flex-wrap:wrap;gap:5px}
.gt-notas-txt .gt-ntag{font-size:10px;padding:3px 10px;border-radius:16px}
.gt-foot{display:flex;flex-direction:column;align-items:center;gap:4px;margin-top:2px}
.gt-price{font-weight:800}
.gt-neg{font-size:9px;text-align:center;line-height:1.35}

/* Formato MINIMAL */
.gt-card.f-min{background:#fff;font-family:'Jost',sans-serif}
.gt-card.f-min .gt-photo{background:#f5f4f1;color:#c9c4bb}
.gt-card.f-min .gt-brand{color:#b0a68f;letter-spacing:.14em;text-transform:uppercase}
.gt-card.f-min .gt-name{color:#232323;font-size:24px}
.gt-card.f-min .gt-sub{color:#9a9a9a}
.gt-card.f-min .gt-btrack{background:#f0eee9}
.gt-card.f-min .gt-bname{color:#8a8a8a}
.gt-card.f-min .gt-ntag{background:#f0eee9;color:#7a7365}
.gt-card.f-min .gt-nota span{color:#8a8a8a}
.gt-card.f-min .gt-price{color:#232323;font-size:22px}
.gt-card.f-min .gt-neg{color:#aaa}

/* Formato LUJO */
.gt-card.f-lux{background:#14110d;font-family:'Cormorant Garamond',serif;text-align:center}
.gt-card.f-lux .gt-photo{height:210px;background:radial-gradient(60% 55% at 50% 42%,#2a2318,#14110d);color:#8a7440}
.gt-card.f-lux.story .gt-photo{height:320px}
.gt-card.f-lux .gt-brand{color:#c9a24b;letter-spacing:.3em;text-transform:uppercase;font-family:'Jost',sans-serif}
.gt-card.f-lux .gt-name{color:#f2e9d6;font-weight:500;font-size:29px}
.gt-card.f-lux .gt-sub{color:#b09a6a;font-family:'Jost',sans-serif;text-transform:uppercase;letter-spacing:.18em;font-size:10px}
.gt-card.f-lux .gt-acc-dots .gt-dring{color:#e6c878;font-family:'Jost',sans-serif}
.gt-card.f-lux .gt-acc-dots .gt-dot span{color:#9a8a6a;font-family:'Jost',sans-serif}
.gt-card.f-lux .gt-notas-foto{justify-content:center}
.gt-card.f-lux .gt-nota span{color:#9a8a6a;font-family:'Jost',sans-serif}
.gt-card.f-lux .gt-ntag{border:1px solid rgba(201,162,75,.4);color:#c9b98a;font-family:'Jost',sans-serif}
.gt-card.f-lux .gt-notas-txt{justify-content:center}
.gt-card.f-lux .gt-foot{flex-direction:column;align-items:center;gap:4px}
.gt-card.f-lux .gt-price{color:#e6c878;font-weight:500;font-size:22px;font-family:'Jost',sans-serif}
.gt-card.f-lux .gt-neg{color:#7a6f58;text-align:center;font-family:'Jost',sans-serif}

/* Formato MODERNO */
.gt-card.f-mod{background:#fff;font-family:'Jost',sans-serif}
.gt-card.f-mod .gt-photo{height:180px;background:linear-gradient(135deg,#efe4fb,#fce4f0);color:#a06fc4}
.gt-card.f-mod.story .gt-photo{height:290px}
.gt-card.f-mod .gt-brand{color:#a89ab5;font-weight:600}
.gt-card.f-mod .gt-name{color:#2a2233;font-size:25px;font-weight:800}
.gt-card.f-mod .gt-sub{color:#a89ab5;font-weight:600}
.gt-card.f-mod .gt-ntag{background:#f3ebfc;color:#7d55a8;font-weight:600}
.gt-card.f-mod .gt-nota span{color:#a89ab5}
.gt-card.f-mod .gt-price{font-size:23px;background:linear-gradient(135deg,#a06fc4,#d4589a);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.gt-card.f-mod .gt-neg{color:#a89ab5}

/* ══ Selector de estilo (grid 10) ══ */
.gt-fmtgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}
.gt-fmtgrid button{background:#f3ebd8;border:none;color:#8a7c60;font-family:'Jost',sans-serif;font-size:11.5px;font-weight:500;padding:9px 4px;border-radius:9px;cursor:pointer;transition:all .2s}
.gt-fmtgrid button.on{background:#a06a2a;color:#fff;font-weight:600;box-shadow:0 2px 8px rgba(160,106,42,.35)}

/* Formato NOCTURNO */
.gt-card.f-noc{background:#0f1729;font-family:'Jost',sans-serif;text-align:center}
.gt-card.f-noc .gt-photo{background:radial-gradient(60% 55% at 50% 40%,#1c2a45,#0f1729);color:#5a7ba0}
.gt-card.f-noc .gt-brand{color:#7fa8d4;letter-spacing:.25em;text-transform:uppercase;font-weight:600}
.gt-card.f-noc .gt-name{color:#eaf1fb;font-size:26px}
.gt-card.f-noc .gt-sub{color:#7a90b0;text-transform:uppercase;letter-spacing:.15em;font-size:10px}
.gt-card.f-noc .gt-acc-dots .gt-dring{color:#a9c7ec}
.gt-card.f-noc .gt-acc-dots .gt-dot span{color:#7a90b0}
.gt-card.f-noc .gt-notas-txt,.gt-card.f-noc .gt-notas-foto{justify-content:center}
.gt-card.f-noc .gt-nota span{color:#7a90b0}
.gt-card.f-noc .gt-ntag{border:1px solid rgba(127,168,212,.4);color:#a9c7ec}
.gt-card.f-noc .gt-foot{flex-direction:column;align-items:center;gap:4px}
.gt-card.f-noc .gt-price{color:#a9c7ec;font-size:22px;font-weight:600}
.gt-card.f-noc .gt-neg{color:#5a7090;text-align:center}

/* Formato NATURAL */
.gt-card.f-nat{background:#f4f1e6;font-family:'Jost',sans-serif}
.gt-card.f-nat .gt-photo{background:#e8e3d0;color:#9aa885}
.gt-card.f-nat .gt-brand{color:#8a9a6a;letter-spacing:.14em;text-transform:uppercase;font-weight:600}
.gt-card.f-nat .gt-name{color:#3d4a2e;font-size:25px}
.gt-card.f-nat .gt-sub{color:#8a9270}
.gt-card.f-nat .gt-btrack{background:#e2ddc8}
.gt-card.f-nat .gt-bname{color:#7a8060}
.gt-card.f-nat .gt-ntag{background:#e5e5d0;color:#5a6440}
.gt-card.f-nat .gt-nota span{color:#7a8060}
.gt-card.f-nat .gt-price{color:#3d4a2e;font-size:22px}
.gt-card.f-nat .gt-neg{color:#9aa080}

/* Formato ROSÉ */
.gt-card.f-rose{background:#fbeef1;font-family:'Jost',sans-serif}
.gt-card.f-rose .gt-photo{background:linear-gradient(135deg,#f8dfe6,#f6e8d8);color:#c98a9a}
.gt-card.f-rose .gt-brand{color:#c98a9a;letter-spacing:.14em;text-transform:uppercase;font-weight:600}
.gt-card.f-rose .gt-name{color:#7a4a52;font-size:25px}
.gt-card.f-rose .gt-sub{color:#b88a92}
.gt-card.f-rose .gt-ntag{background:#f7dce3;color:#a85a68;font-weight:600}
.gt-card.f-rose .gt-nota span{color:#b88a92}
.gt-card.f-rose .gt-price{color:#c07082;font-size:23px;font-weight:800}
.gt-card.f-rose .gt-neg{color:#c09aa0}

/* Formato EDITORIAL */
.gt-card.f-edi{background:#fff;font-family:'Cormorant Garamond',serif}
.gt-card.f-edi .gt-photo{background:#f7f6f4;color:#c9c4bb;border-bottom:1px solid #1a1a1a}
.gt-card.f-edi .gt-brand{color:#1a1a1a;letter-spacing:.3em;text-transform:uppercase;font-family:'Jost',sans-serif;font-weight:600;font-size:9px}
.gt-card.f-edi .gt-name{color:#111;font-size:32px;font-weight:600}
.gt-card.f-edi .gt-sub{color:#888;font-family:'Jost',sans-serif;text-transform:uppercase;letter-spacing:.12em;font-size:9px}
.gt-card.f-edi .gt-btrack{background:#eee}
.gt-card.f-edi .gt-bname{color:#888;font-family:'Jost',sans-serif}
.gt-card.f-edi .gt-ntag{border:1px solid #ddd;color:#666;font-family:'Jost',sans-serif}
.gt-card.f-edi .gt-nota span{color:#888;font-family:'Jost',sans-serif}
.gt-card.f-edi .gt-price{color:#111;font-size:26px;font-weight:600}
.gt-card.f-edi .gt-neg{color:#aaa;font-family:'Jost',sans-serif}

/* Formato NEÓN */
.gt-card.f-neo{background:#0a0a12;font-family:'Jost',sans-serif}
.gt-card.f-neo .gt-photo{background:radial-gradient(60% 55% at 50% 42%,#1a1030,#0a0a12);color:#c050e0}
.gt-card.f-neo .gt-brand{color:#00e5d0;letter-spacing:.22em;text-transform:uppercase;font-weight:600}
.gt-card.f-neo .gt-name{color:#fff;font-size:26px;font-weight:800}
.gt-card.f-neo .gt-sub{color:#c050e0;text-transform:uppercase;letter-spacing:.12em;font-size:10px}
.gt-card.f-neo .gt-acc-pills .gt-pill{color:#0a0a12;font-weight:700}
.gt-card.f-neo .gt-ntag{border:1px solid rgba(0,229,208,.5);color:#00e5d0}
.gt-card.f-neo .gt-nota span{color:#a070c0}
.gt-card.f-neo .gt-price{color:#00e5d0;font-size:23px;font-weight:800}
.gt-card.f-neo .gt-neg{color:#7a6a9a}

/* Formato AURORA */
.gt-card.f-aur{background:linear-gradient(160deg,#3a2a6a,#6a4a9a 45%,#c56a9a);font-family:'Jost',sans-serif}
.gt-card.f-aur .gt-photo{background:rgba(255,255,255,.1);color:rgba(255,255,255,.55)}
.gt-card.f-aur .gt-brand{color:rgba(255,255,255,.85);letter-spacing:.2em;text-transform:uppercase;font-weight:600}
.gt-card.f-aur .gt-name{color:#fff;font-size:26px;font-weight:700}
.gt-card.f-aur .gt-sub{color:rgba(255,255,255,.75)}
.gt-card.f-aur .gt-acc-pills .gt-pill{color:#fff;font-weight:700}
.gt-card.f-aur .gt-btrack{background:rgba(255,255,255,.2)}
.gt-card.f-aur .gt-bname{color:rgba(255,255,255,.8)}
.gt-card.f-aur .gt-ntag{background:rgba(255,255,255,.2);color:#fff}
.gt-card.f-aur .gt-nota span{color:rgba(255,255,255,.8)}
.gt-card.f-aur .gt-price{color:#fff;font-size:23px;font-weight:800}
.gt-card.f-aur .gt-neg{color:rgba(255,255,255,.7)}

/* Formato CLÁSICO */
.gt-card.f-cla{background:#f4ecd8;font-family:'Cormorant Garamond',serif;text-align:center}
.gt-card.f-cla .gt-photo{background:#ebe1c8;color:#b0a075}
.gt-card.f-cla .gt-body{margin:8px;border:1px solid #cbb884;border-radius:6px;padding:14px}
.gt-card.f-cla .gt-brand{color:#a68a4a;letter-spacing:.25em;text-transform:uppercase;font-family:'Jost',sans-serif;font-size:9px}
.gt-card.f-cla .gt-name{color:#3a2f1a;font-size:29px;font-weight:600}
.gt-card.f-cla .gt-sub{color:#a0895a;font-family:'Jost',sans-serif;text-transform:uppercase;letter-spacing:.15em;font-size:10px}
.gt-card.f-cla .gt-acc-dots .gt-dring{color:#a68a4a;font-family:'Jost',sans-serif}
.gt-card.f-cla .gt-acc-dots .gt-dot span{color:#8a7550;font-family:'Jost',sans-serif}
.gt-card.f-cla .gt-notas-txt,.gt-card.f-cla .gt-notas-foto{justify-content:center}
.gt-card.f-cla .gt-nota span{color:#8a7550;font-family:'Jost',sans-serif}
.gt-card.f-cla .gt-ntag{border:1px solid #cbb884;color:#8a7040;font-family:'Jost',sans-serif}
.gt-card.f-cla .gt-foot{flex-direction:column;align-items:center;gap:4px}
.gt-card.f-cla .gt-price{color:#8a6a2a;font-size:22px;font-family:'Jost',sans-serif;font-weight:600}
.gt-card.f-cla .gt-neg{color:#a0895a;text-align:center;font-family:'Jost',sans-serif}

/* ══ Ajustes de diseño (badges, precio, centrado, foto) ══ */
.gt-badges{display:flex;gap:7px;justify-content:center;flex-wrap:wrap;margin:3px 0 12px}
.gt-badge{font-size:11px;font-weight:700;padding:3px 13px;border-radius:8px;color:#fff;letter-spacing:.03em;line-height:1.5}
.gt-badge-0{background:#c9a24b}
.gt-badge-1{background:#7a9e6a}
.gt-pricebox{display:inline-block;border:1px solid rgba(160,140,90,.45);border-radius:11px;padding:4px 22px;margin-bottom:13px}
.gt-pricebox .gt-price{font-weight:800}
.gt-acc-pills{justify-content:center}
.gt-notas-foto{justify-content:center}
.gt-notas-txt{justify-content:center}
.gt-acc-bars{max-width:215px;margin-left:auto;margin-right:auto}
.gt-card.f-lux .gt-photo,.gt-card.f-noc .gt-photo,.gt-card.f-neo .gt-photo,.gt-card.f-aur .gt-photo{background:#efe9df}

/* ══ Fase 3: color de acento ══ */
.gt-swatches{display:flex;gap:8px;flex-wrap:wrap}
.gt-sw{width:28px;height:28px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1px #e0d3b8;cursor:pointer;padding:0;transition:transform .15s}
.gt-sw:hover{transform:scale(1.12)}
.gt-sw.on{box-shadow:0 0 0 2px #a06a2a;transform:scale(1.12)}
.gt-sw-auto{background:conic-gradient(#c9a24b,#d4589a,#8a5ac4,#3a7bd4,#5a9e4a,#c9a24b);color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center}
.gt-card.gt-hascolor .gt-badge-0{background:var(--gtacc)}
.gt-card.gt-hascolor .gt-pricebox{border-color:var(--gtacc)}
.gt-card.gt-hascolor .gt-pricebox .gt-price{color:var(--gtacc)}

@media(max-width:800px){
  .gt-grid{grid-template-columns:1fr;gap:18px}
  .gt-preview{position:static;order:-1;padding:0 0 6px}
  .gt-wrap{padding:56px 10px 36px}
  .gt-card{margin:0 auto}
}
</style>
</head>
<body>
<div id="annBar"><div class="ann-track" id="annTrack"></div></div>
<header>
  <div class="logo" onclick="_logoHome()" style="cursor:pointer" title="Volver al inicio">Distribuidora <span>Belle</span></div>
  <div style="display:flex;align-items:center;gap:.6rem">
    <button id="catBellBtn" onclick="catToggleNotifs()" title="Notificaciones" style="display:none;position:relative;align-items:center;justify-content:center;background:transparent;border:1.5px solid var(--border-color);color:var(--tx-mid);border-radius:50%;width:38px;height:38px;cursor:pointer;font-size:1.05rem;flex-shrink:0">
      &#128276;
      <span id="catBellBadge" style="display:none;position:absolute;top:-5px;right:-5px;min-width:17px;height:17px;padding:0 4px;border-radius:9px;background:#e2574e;color:#fff;font-size:.62rem;font-weight:700;align-items:center;justify-content:center;font-family:'DM Sans',sans-serif;line-height:1">0</span>
    </button>
    <button id="catCuentaBtn" class="cuenta-btn" onclick="toggleMiCuenta()" title="Mi cuenta">
      <span id="catCuentaIcon">&#128100;</span>
      <span id="catCuentaLabel">Mi Cuenta</span>
    </button>
    <button id="themeBtn" onclick="toggleTheme()" style="display:flex;align-items:center;gap:.35rem;background:transparent;border:1.5px solid var(--border-color);color:var(--tx-mid);border-radius:20px;padding:.35rem .8rem;font-size:.75rem;cursor:pointer;font-family:'DM Sans',sans-serif;white-space:nowrap" title="Cambiar tema">
      <span id="themeIcon">&#127769;</span>
    </button>
    <button class="cart-btn" onclick="toggleCart()">Mi pedido <span class="cart-count" id="cartCount">0</span></button>
  </div>
</header>
<div id="catNotifDrop" style="display:none;position:fixed;top:64px;right:1rem;width:330px;max-width:calc(100vw - 2rem);background:#ffffff;border:1px solid #e8d9bf;border-radius:14px;box-shadow:0 12px 40px rgba(184,158,110,.28);z-index:9998;overflow:hidden">
  <div style="padding:.7rem .9rem;border-bottom:1px solid #f0e7d6;display:flex;align-items:center;justify-content:space-between;background:#ffffff">
    <span style="font-size:.85rem;font-weight:700;color:#5a4a30">&#128276; Notificaciones</span>
    <span onclick="catToggleNotifs()" style="cursor:pointer;color:#9a8870;font-size:1.2rem;line-height:1;padding:0 .2rem">&times;</span>
  </div>
  <div id="catNotifDropBody" style="max-height:62vh;overflow-y:auto"></div>
</div>
<div class="carousel" id="carousel">
  <div class="carousel-track" id="carTrack"></div>
  <button class="car-btn car-prev" onclick="carMove(-1)">&#8249;</button>
  <button class="car-btn car-next" onclick="carMove(1)">&#8250;</button>
  <div class="car-dots" id="carDots"></div>
</div>
<div style="position:relative">
<button id="catTabsHambBtn" onclick="catAbrirTabsDrawer()" aria-label="Menú de pestañas">
  <span></span><span></span><span></span>
</button>
<div class="tabs" id="tabsContainer"><div class="tab" onclick="switchTab('inicio',this)">🏠 Inicio</div><div class="tab act" onclick="switchTab('arabes',this)">Arabes</div><div class="tab" onclick="switchTab('internacionales',this)">Internacionales</div></div>
</div>
<div id="catTabsDrawerOverlay" onclick="catCerrarTabsDrawer()"></div>
<div id="catTabsDrawer">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.2rem;border-bottom:1px solid var(--border-color)">
    <strong style="font-size:1rem;color:var(--charcoal)">Categorías</strong>
    <button onclick="catCerrarTabsDrawer()" style="background:transparent;border:none;font-size:1.6rem;cursor:pointer;color:var(--tx-mid);line-height:1;padding:0 .3rem">&times;</button>
  </div>
  <div id="catTabsDrawerLista" style="padding:.5rem 0"></div>
  <div style="margin-top:.4rem;padding:.9rem 1.1rem;border-top:1px solid var(--border-color)">
    <div style="font-size:.62rem;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.6rem">✦ Descubrí</div>
    <button onclick="catToggleFavsView(true)" style="display:flex;align-items:center;gap:.6rem;width:100%;text-align:left;background:#fff;color:#c2415a;border:1.5px solid #f3c9d4;border-radius:11px;padding:.7rem .8rem;cursor:pointer;margin-bottom:.5rem;font-family:inherit">
      <span style="font-size:1.25rem;line-height:1">&#10084;&#65039;</span>
      <span style="line-height:1.2"><span style="display:block;font-weight:700;font-size:.82rem">Mis favoritos</span><span style="display:block;font-size:.64rem;opacity:.8">Los perfumes que marcaste</span></span>
    </button>
    <button onclick="catCerrarTabsDrawer();abrirDupeFinder()" style="display:flex;align-items:center;gap:.6rem;width:100%;text-align:left;background:linear-gradient(135deg,#c4965a,#a9763f);color:#fff;border:none;border-radius:11px;padding:.7rem .8rem;cursor:pointer;margin-bottom:.5rem;font-family:inherit">
      <span style="font-size:1.25rem;line-height:1">&#127919;</span>
      <span style="line-height:1.2"><span style="display:block;font-weight:700;font-size:.82rem">Tu versión árabe</span><span style="display:block;font-size:.64rem;opacity:.9">Buscá tu perfume y su dupe</span></span>
    </button>
    <button onclick="catCerrarTabsDrawer();abrirQuiz()" style="display:flex;align-items:center;gap:.6rem;width:100%;text-align:left;background:#fff;color:#3a2f22;border:1.5px solid #e0cda8;border-radius:11px;padding:.7rem .8rem;cursor:pointer;font-family:inherit">
      <span style="font-size:1.25rem;line-height:1">&#10024;</span>
      <span style="line-height:1.2"><span style="display:block;font-weight:700;font-size:.82rem">Encontrá tu perfume</span><span style="display:block;font-size:.64rem;color:var(--tx-mid)">Quiz de 4 preguntas</span></span>
    </button>
  </div>
</div>
<div class="filters" id="catFilters">
  <div class="sw" id="catSearchWrap"><span class="sw-i">&#128269;</span><input type="text" id="srch" placeholder="Buscar perfume..." autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" oninput="applyFilters()"></div>
  <!-- Fila de botones de acción (en mobile aparecen abajo del buscador, en desktop al lado) -->
  <div id="catBotonesFila" style="display:contents">
    <button id="btnFiltrosMobile" onclick="toggleFiltrosMobile()" style="display:none;align-items:center;gap:.4rem;background:transparent;border:1.5px solid var(--accent);color:var(--accent);border-radius:20px;padding:.3rem .85rem;font-size:.72rem;cursor:pointer;white-space:nowrap">🔧 Filtros<span id="filtrosBadge" style="display:none;background:var(--accent);color:#fff;border-radius:10px;padding:.05rem .35rem;font-size:.62rem;font-weight:700;min-width:16px;text-align:center"></span></button>
    <button onclick="abrirModalComparador()" style="display:flex;align-items:center;gap:.4rem;background:transparent;border:1.5px solid rgba(77,150,255,.5);color:#4d96ff;border-radius:20px;padding:.3rem .85rem;font-size:.72rem;cursor:pointer;white-space:nowrap">⚖ Comparar</button>
    <button id="btnAcordesPanel" onclick="toggleAcordesPanel()" style="display:flex;align-items:center;gap:.4rem;background:transparent;border:1.5px solid var(--accent);color:var(--accent);border-radius:20px;padding:.3rem .85rem;font-size:.72rem;cursor:pointer;white-space:nowrap">&#127800; Acordes<span id="acordesBadge" style="display:none;background:var(--accent);color:#fff;border-radius:10px;padding:.05rem .35rem;font-size:.62rem;font-weight:700;min-width:16px;text-align:center"></span></button>
  </div>
  <!-- Filtros que se colapsan en mobile (marcas + género/kit) -->
  <div id="filtrosColapsables" style="display:contents">
    <select class="fsel" id="brandFilter" onchange="applyFilters()"><option value="">Todas las marcas</option></select>
    <select class="fsel" id="inspiradoFilter" onchange="applyFilters()" title="Filtrar por perfume inspirador (dupe)"><option value="">Inspirado en…</option></select>
    <select class="fsel" id="ordenFilter" onchange="setOrden(this.value)" title="Ordenar productos"><option value="">Ordenar por…</option><option value="precio_asc">Precio: menor a mayor</option><option value="precio_desc">Precio: mayor a menor</option><option value="nuevo">Más nuevos</option><option value="vendidos">Más vendidos</option><option value="az">Nombre (A-Z)</option></select>
    <div class="pills">
      <div class="pill act" onclick="setGen('',this)">Todos</div>
      <div class="pill" onclick="setGen('fem',this)">Mujer</div>
      <div class="pill" onclick="setGen('mas',this)">Hombre</div>
      <div class="pill" onclick="setGen('U',this)">Unisex</div>
      <div class="pill pill-kit" onclick="setKit(this)" style="background:transparent;border:1px solid rgba(184,158,110,.5);color:#b89e6e">&#127873; Kit</div>
    </div>
  </div>
  <span class="rcount" id="rcount" style="display:none"></span>
</div>
<div id="acordesPanel" style="display:none;background:var(--bg-header);border:1px solid var(--border-color);border-radius:12px;margin:.4rem 0 .6rem;padding:.9rem 1rem;box-shadow:0 4px 20px rgba(0,0,0,.07)">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.7rem">
    <div>
      <span style="font-weight:600;color:#c4965a;font-size:.82rem">&#127800; Acordes y notas</span>
      <span style="font-size:.65rem;color:#aaa;margin-left:.5rem">Tocá los que querés que tenga tu perfume</span>
    </div>
    <div style="display:flex;gap:.4rem;align-items:center">
      <button id="btnLimpiarAcordes" onclick="limpiarAcordes()" style="display:none;background:transparent;border:1px solid #e8e3db;color:#aaa;border-radius:6px;padding:.15rem .45rem;font-size:.65rem;cursor:pointer">Limpiar</button>
      <button onclick="toggleAcordesPanel()" style="background:transparent;border:none;color:#ccc;font-size:1rem;cursor:pointer;line-height:1;padding:.1rem .3rem">&#10005;</button>
    </div>
  </div>
  <div id="acordesSeleccionados" style="display:none;margin-bottom:.6rem;padding:.4rem .6rem;background:#fdf5ea;border-radius:8px;border:1px solid #ead9a8">
    <div style="font-size:.63rem;color:#aaa;margin-bottom:.28rem;font-style:italic">Filtrando por:</div>
    <div id="acordesTagsSeleccionados" style="display:flex;flex-wrap:wrap;gap:.25rem"></div>
  </div>
  <div style="margin-bottom:.5rem">
    <input id="acordesPanelSearch" type="text" placeholder="Buscar acorde..." oninput="renderAcordesPanel(this.value)" style="width:100%;box-sizing:border-box;background:#fff;border:1px solid #e8e3db;border-radius:8px;padding:.32rem .6rem;color:#1a1a1a;font-size:.73rem;outline:none">
  </div>
  <div id="acordesPanelGrid" style="display:flex;flex-wrap:wrap;gap:.26rem;max-height:160px;overflow-y:auto;padding:.05rem"></div>
  <div style="margin-top:.85rem;padding-top:.75rem;border-top:1px solid #ede9e3">
    <div style="font-size:.65rem;color:#aaa;font-style:italic;margin-bottom:.35rem">Notas olfativas — escribí para buscar:</div>
    <div id="notasWrap" style="position:relative">
      <div style="display:flex;align-items:center;background:#fff;border:1px solid #e8e3db;border-radius:8px;padding:.08rem .5rem">
        <span style="color:#c4965a;font-size:.78rem;margin-right:.3rem">&#127800;</span>
        <input id="notasSearchInput" type="text" placeholder="ej: bergamota, rosa, vetiver..." oninput="notasAutoComplete(this.value)" onfocus="notasShowTop()" autocomplete="off" style="border:none;background:transparent;color:#1a1a1a;font-size:.73rem;width:100%;outline:none;padding:.28rem 0">
      </div>
      <div id="notasSugerencias" style="display:none;position:absolute;left:0;right:0;top:calc(100% + 4px);background:#fff;border:1px solid #e8e3db;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.09);z-index:500;overflow:hidden;max-height:200px;overflow-y:auto"></div>
    </div>
    <div id="notasTagsWrap" style="display:flex;flex-wrap:wrap;gap:.22rem;margin-top:.4rem"></div>
  </div>
</div>
<div class="lw">
<div id="homePage" style="display:none;padding:0"></div>
<div id="contactoPage" style="display:none;padding:1.5rem 0"></div>
<div id="notasPage" style="display:none;padding:.7rem"></div>
<div id="serviciosOverlay"></div>
<div id="genTarjetaOverlay"></div>
<div id="destacadosContainer"></div>
<div id="pestanaSeccionesContainer"></div>
  <div id="combosSecCat" style="display:none;margin-bottom:1rem"></div>
<!-- Modal Comparador -->
<div id="moComparadorBelle" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.65);backdrop-filter:blur(4px);overflow-y:auto;padding:clamp(.4rem,3vw,1.2rem)">
  <div style="max-width:920px;margin:0 auto;border-radius:20px;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.45);background:var(--bg-card);color:var(--tx-main)">
    <!-- Header con gradiente de la web -->
    <div id="compHeader" style="background:linear-gradient(135deg,#2d1a0a,#5a3a1a);padding:1.3rem 1.6rem;display:flex;justify-content:space-between;align-items:center;position:relative;overflow:hidden">
      <div style="position:absolute;top:-30px;right:-30px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgba(196,150,90,.25),transparent 70%);pointer-events:none"></div>
      <div style="position:absolute;bottom:-40px;left:80px;width:140px;height:140px;border-radius:50%;background:radial-gradient(circle,rgba(196,150,90,.12),transparent 70%);pointer-events:none"></div>
      <div style="position:relative">
        <div style="font-size:1.05rem;font-weight:700;color:#e8b86d;display:flex;align-items:center;gap:.5rem">⚖ Comparador de Perfumes</div>
        <div style="font-size:.68rem;color:rgba(232,184,109,.6);margin-top:.2rem">Seleccioná hasta 4 perfumes para comparar</div>
      </div>
